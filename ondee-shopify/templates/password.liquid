<div class="wrap centre cta-final sect">
  <p class="oeil oeil--centre">Bientôt</p>
  <h2>{{ shop.name }}</h2>
  <p class="chapeau">{{ shop.password_message | default: "On ne promet pas. On prouve." }}</p>
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="chercheur__champ" style="max-width:22rem;margin:2rem auto 0">
      <input class="saisie" type="password" name="password" placeholder="Mot de passe" aria-label="Mot de passe">
      <button class="btn btn--primaire" type="submit">Entrer</button>
    </div>
  {%- endform -%}
</div>
