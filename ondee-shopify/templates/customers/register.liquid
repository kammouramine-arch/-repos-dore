<div class="wrap wrap--etroit sect">
  <p class="oeil">Espace client</p>
  <h1 class="titre-sect">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div class="champ"><label class="champ__l" for="r-prenom"><span>{{ 'customer.register.first_name' | t }}</span></label><input class="saisie" id="r-prenom" type="text" name="customer[first_name]" autocomplete="given-name"></div>
    <div class="champ"><label class="champ__l" for="r-nom"><span>{{ 'customer.register.last_name' | t }}</span></label><input class="saisie" id="r-nom" type="text" name="customer[last_name]" autocomplete="family-name"></div>
    <div class="champ"><label class="champ__l" for="r-email"><span>{{ 'customer.register.email' | t }}</span></label><input class="saisie" id="r-email" type="email" name="customer[email]" autocomplete="email" required></div>
    <div class="champ"><label class="champ__l" for="r-pass"><span>{{ 'customer.register.password' | t }}</span></label><input class="saisie" id="r-pass" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <button class="btn btn--primaire btn--bloc" type="submit">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</div>
