<div class="wrap wrap--etroit sect">
  <h1 class="titre-sect">{{ 'customer.reset_password.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="champ"><label class="champ__l"><span>{{ 'customer.reset_password.password' | t }}</span></label><input class="saisie" type="password" name="customer[password]" required></div>
    <div class="champ"><label class="champ__l"><span>{{ 'customer.reset_password.password_confirm' | t }}</span></label><input class="saisie" type="password" name="customer[password_confirmation]" required></div>
    <button class="btn btn--primaire btn--bloc" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>
