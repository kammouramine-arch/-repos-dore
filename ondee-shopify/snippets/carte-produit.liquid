<a class="avis" href="{{ p.url }}" style="text-decoration:none">
  <div style="aspect-ratio:1;background:var(--craie);border-radius:var(--r);overflow:hidden;border:1px solid var(--trait)">
    {%- if p.featured_media -%}
      <img src="{{ p.featured_media | image_url: width: 700 }}" alt="{{ p.featured_media.alt | escape }}" width="500" height="500" loading="lazy" style="width:100%;height:100%;object-fit:cover">
    {%- else -%}
      <img src="{{ 'pommeau.svg' | asset_url }}" alt="{{ p.title | escape }}" width="500" height="500" loading="lazy" style="width:100%;height:100%;object-fit:cover">
    {%- endif -%}
  </div>
  <div class="ligne__t" style="font-size:var(--t-base)">{{ p.title }}</div>
  <div class="avis__meta">
    <b class="mono">{% if p.price_varies %}dès {% endif %}{{ p.price_min | money }}</b>
    <span>{% if p.available %}Voir{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
  </div>
</a>
