<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.c_petrole }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%230E3A45'/%3E%3Cpath d='M16 7c4 5 6.5 8 6.5 11a6.5 6.5 0 0 1-13 0C9.5 15 12 12 16 7z' fill='%239FC7D2'/%3E%3C/svg%3E">

  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

  {{ 'instrument-sans-latin.woff2' | asset_url | preload_tag: as: 'font' }}
  {{ 'plex-mono-400-latin.woff2' | asset_url | preload_tag: as: 'font' }}
  <style>
    /* Polices auto-hébergées (SIL Open Font License) — servies par le CDN Shopify.
       Supprime 3 requêtes externes et le blocage de rendu de Google Fonts. */
    @font-face{font-family:'Instrument Sans';font-style:normal;font-weight:400 600;font-display:swap;
      src:url({{ 'instrument-sans-latin.woff2' | asset_url }}) format('woff2');
      unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
    @font-face{font-family:'Instrument Sans';font-style:normal;font-weight:400 600;font-display:swap;
      src:url({{ 'instrument-sans-latin-ext.woff2' | asset_url }}) format('woff2');
      unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}
    @font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:400;font-display:swap;
      src:url({{ 'plex-mono-400-latin.woff2' | asset_url }}) format('woff2');
      unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
    @font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:400;font-display:swap;
      src:url({{ 'plex-mono-400-latin-ext.woff2' | asset_url }}) format('woff2');
      unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}
    @font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:500;font-display:swap;
      src:url({{ 'plex-mono-500-latin.woff2' | asset_url }}) format('woff2');
      unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
    @font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:500;font-display:swap;
      src:url({{ 'plex-mono-500-latin-ext.woff2' | asset_url }}) format('woff2');
      unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}
  </style>
  {{ 'ondee.css' | asset_url | stylesheet_tag }}

  <style>
    :root{
      --craie:{{ settings.c_craie }};
      --papier:{{ settings.c_papier }};
      --encre:{{ settings.c_encre }};
      --petrole:{{ settings.c_petrole }};
      --eau:{{ settings.c_eau }};
      --reactif:{{ settings.c_reactif }};
    }
  </style>

  <script>document.documentElement.className += " js";</script>
  {{ content_for_header }}
</head>

<body class="template-{{ template.name | handle }}">
  <a class="skip" href="#main">{{ 'general.accessibility.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="main" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- render 'panier-tiroir' -%}
  <div class="toast" data-toast role="status" aria-live="polite"></div>

  <script>
    window.ONDEE = {
      routes: {
        cart_add:    "{{ routes.cart_add_url }}.js",
        cart_change: "{{ routes.cart_change_url }}.js",
        cart:        "{{ routes.cart_url }}.js",
        cart_page:   "{{ routes.cart_url }}",
        checkout:    "/checkout"
      },
      moneyFormat: {{ shop.money_format | json }},
      strings: {
        added: "ajouté au panier",
        empty: {{ 'cart.general.empty' | t | json }},
        remove: {{ 'cart.general.remove' | t | json }}
      }
    };
  </script>
  <script src="{{ 'ondee.js' | asset_url }}" defer></script>
</body>
</html>
