<section class="sect encre">
  <div class="wrap centre">
    <p class="oeil oeil--centre">{{ section.settings.oeil }}</p>
    <h2 class="titre-sect">{{ section.settings.titre }}</h2>
    <div class="chapeau">{{ section.settings.chapeau }}</div>
    {%- if section.settings.cta_txt != blank -%}
      <p style="margin-top:2rem"><a class="btn btn--clair" href="{{ section.settings.cta_url }}">{{ section.settings.cta_txt }}</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Preuve sociale",
  "settings": [
    { "type": "text", "id": "oeil", "label": "Surtitre", "default": "Ce qui se passe ailleurs" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "La France est en retard d'un filtre." },
    { "type": "richtext", "id": "chapeau", "label": "Texte" },
    { "type": "text", "id": "cta_txt", "label": "Bouton", "default": "Voir les relevés de ma commune" },
    { "type": "url", "id": "cta_url", "label": "Lien" }
  ],
  "presets": [ { "name": "Preuve sociale" } ]
}
{% endschema %}
