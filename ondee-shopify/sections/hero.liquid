<section class="hero">
  <div class="wrap hero__grid">
    <div>
      {%- if section.settings.oeil != blank -%}<p class="oeil">{{ section.settings.oeil }}</p>{%- endif -%}
      <h1>{{ section.settings.titre }}</h1>
      <div class="hero__sous">{{ section.settings.sous }}</div>
      <div class="hero__cta">
        {%- if section.settings.cta1_txt != blank -%}<a class="btn btn--primaire" href="{{ section.settings.cta1_url }}">{{ section.settings.cta1_txt }}</a>{%- endif -%}
        {%- if section.settings.cta2_txt != blank -%}<a class="btn btn--fantome" href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_txt }}</a>{%- endif -%}
      </div>
      <ul class="hero__rassure">
        {%- for b in section.blocks -%}
          <li {{ b.shopify_attributes }}><svg viewBox="0 0 24 24"><path d="m4 12 6 6L20 6" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ b.settings.txt }}</li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="visu">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}" width="800" height="1000" fetchpriority="high">
      {%- else -%}
        <img src="{{ 'pommeau.svg' | asset_url }}" alt="{{ shop.name }}" width="800" height="1000" fetchpriority="high">
      {%- endif -%}
      {%- if section.settings.tag != blank -%}<span class="visu__tag mono">{{ section.settings.tag }}</span>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Héros",
  "settings": [
    { "type": "text", "id": "oeil", "label": "Surtitre", "default": "Filtre de douche · cartouche 90 jours" },
    { "type": "html", "id": "titre", "label": "Titre", "default": "Votre eau de douche est chlorée.<br><em>Voici de combien.</em>" },
    { "type": "richtext", "id": "sous", "label": "Sous-titre", "default": "<p>ONDÉE réduit le chlore de l'eau de votre douche — celui qui assèche la peau et ternit les cheveux. Tapez le nom de votre commune : nous affichons les relevés officiels du ministère de la Santé pour votre réseau. Avant même que vous achetiez quoi que ce soit.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "tag", "label": "Étiquette sur l'image", "default": "Cartouche visible · on voit le filtre travailler" },
    { "type": "text", "id": "cta1_txt", "label": "Bouton 1", "default": "Découvrir ONDÉE — 79 €" },
    { "type": "url", "id": "cta1_url", "label": "Lien 1" },
    { "type": "text", "id": "cta2_txt", "label": "Bouton 2", "default": "Analyser mon eau" },
    { "type": "url", "id": "cta2_url", "label": "Lien 2" }
  ],
  "blocks": [ { "type": "point", "name": "Point de réassurance", "limit": 4, "settings": [ { "type": "text", "id": "txt", "label": "Texte" } ] } ],
  "presets": [ { "name": "Héros" } ]
}
{% endschema %}
