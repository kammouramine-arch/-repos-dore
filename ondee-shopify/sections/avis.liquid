{%- comment -%}
  ⚠ N'AFFICHEZ ICI QUE DES AVIS RÉELLEMENT COLLECTÉS ET VÉRIFIÉS.
  Publier de faux avis est une pratique commerciale trompeuse interdite
  (directive Omnibus (UE) 2019/2161 ; art. L.121-2 et L.121-4 11° du code
  de la consommation). Cette section est livrée VIDE volontairement :
  branchez Judge.me / Loox, ou saisissez ici de vrais avis clients.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="sect {{ section.settings.fond }}" id="avis">
  <div class="wrap">
    <p class="oeil">{{ section.settings.oeil }}</p>
    <h2 class="titre-sect">{{ section.settings.titre }}</h2>
    {%- if section.settings.chapeau != blank -%}<div class="chapeau">{{ section.settings.chapeau }}</div>{%- endif -%}
    <div class="avis-g">
      {%- for b in section.blocks -%}
        <article class="avis rev"{{ b.shopify_attributes }}>
          <div class="etoiles" aria-label="{{ b.settings.note }} étoiles sur 5">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" {% if i > b.settings.note %}style="fill:#CFC8BA"{% endif %}><path d="m12 2 3 6.6 7 .8-5.2 4.8 1.4 7L12 17.8 5.8 21.2l1.4-7L2 9.4l7-.8z"/></svg>
            {%- endfor -%}
          </div>
          <p>{{ b.settings.texte }}</p>
          <div class="avis__meta">
            <b>{{ b.settings.auteur }}</b>
            {%- if b.settings.mention != blank -%}<span class="mono">{{ b.settings.mention }}</span>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Avis clients",
  "settings": [
    { "type": "paragraph", "content": "⚠ N'ajoutez ici que des avis RÉELS. Publier de faux avis est interdit (directive Omnibus UE 2019/2161, art. L.121-2 du code de la consommation)." },
    { "type": "select", "id": "fond", "label": "Fond", "options": [ { "value": "", "label": "Craie" }, { "value": "papier", "label": "Papier" } ], "default": "" },
    { "type": "text", "id": "oeil", "label": "Surtitre", "default": "Avis vérifiés" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Ce que les gens disent, y compris quand c'est mitigé." },
    { "type": "richtext", "id": "chapeau", "label": "Chapeau" }
  ],
  "blocks": [ { "type": "avis", "name": "Avis client (réel)", "settings": [
    { "type": "range", "id": "note", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "textarea", "id": "texte", "label": "Avis (verbatim du client)" },
    { "type": "text", "id": "auteur", "label": "Auteur" },
    { "type": "text", "id": "mention", "label": "Mention (ville, dureté…)" }
  ] } ],
  "presets": [ { "name": "Avis clients" } ]
}
{% endschema %}
