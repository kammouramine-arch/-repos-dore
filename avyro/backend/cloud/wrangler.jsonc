{
	"name": "avyro-gateway",
	"account_id": "25a1a142dff294b87c4366178391ee04",
	"main": "worker.mjs",
	"compatibility_date": "2026-10-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"ai": { "binding": "AI" },
	"durable_objects": {
		"bindings": [
			{
				"name": "PASSWORD_HASHER",
				"class_name": "PasswordHasher"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"PasswordHasher"
			]
		}
	],
	"observability": {
		"enabled": false
	},
	"vars": {
		"ROAD_DATA_ENABLED": "true",
		"AI_ENABLED": "true"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "avyro-beta",
			"database_id": "184bb562-8dd0-4a7e-bbfe-36ce473e5f54"
		}
	],
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	}
}
