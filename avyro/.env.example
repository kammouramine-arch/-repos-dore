# ---------------------------------------------------------------------------
# Avyro — environment configuration
# Copy to `.env` (git-ignored) and adjust. Nothing here is secret at runtime:
# every EXPO_PUBLIC_* value is compiled into the app bundle.
# ---------------------------------------------------------------------------

# Geocoding / destination search (Nominatim-compatible).
# The default is OpenStreetMap's public instance: fine for development, rate
# limited and not permitted for production traffic. Point this at your own.
EXPO_PUBLIC_PLACES_BASE_URL=https://nominatim.openstreetmap.org

# Route planning (OSRM-compatible).
# The default is the OSRM demo server — development only, no uptime guarantee.
EXPO_PUBLIC_ROUTING_BASE_URL=https://router.project-osrm.org

# Sent as User-Agent on every request. Public OSM services require a
# contactable identifier and throttle anonymous traffic.
EXPO_PUBLIC_USER_AGENT=AvyroDrivingCompanion/1.0 (contact@your-domain.example)

# ---------------------------------------------------------------------------
# AI Gateway (optional). Leave all three empty and Avyro answers deterministically:
# every command, question and reroute still works — see docs/Developer-Bible.md §4.
# ---------------------------------------------------------------------------

# Where AI requests go. This should be YOUR OWN proxy, not api.openai.com.
# The proxy holds the provider credential, applies your rate limits, and is the
# only place a provider can be swapped without shipping an app update.
EXPO_PUBLIC_AI_GATEWAY_URL=

# Direct provider key — LOCAL DEVELOPMENT ONLY.
# EXPO_PUBLIC_* values are compiled into the bundle, so a key set here is a key
# you have published: extractable from the binary in minutes and billable to you
# indefinitely. Never set this in a build you distribute.
EXPO_PUBLIC_AI_API_KEY=

# Model identifier passed through to the endpoint. Defaults to AI.defaultModel.
EXPO_PUBLIC_AI_MODEL=

# ---------------------------------------------------------------------------
# Build-time only (read by app.config.ts, never shipped in the JS bundle)
# ---------------------------------------------------------------------------

# Required for Android builds — Google Maps SDK for Android key.
# iOS renders Apple Maps and needs no key.
GOOGLE_MAPS_ANDROID_API_KEY=
