{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "connected-beta": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://conjunction-spears-seeks-kinase.trycloudflare.com",
        "EXPO_PUBLIC_ROAD_DATA_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6799133947"
      }
    }
  }
}
