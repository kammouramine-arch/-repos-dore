{
  // The edge functions are Deno code and are excluded from the app's tsconfig, so
  // nothing typechecked them outside CI's `deno check`. This configuration checks the
  // provider-neutral AI layer and the migrated entrypoints with plain tsc, so a
  // mistake surfaces in seconds rather than at deploy time.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "edge-shims.d.ts",
    "_shared/ai/**/*.ts",
    "ai-chat/index.ts",
    "daily-brief/index.ts",
    "transcribe/index.ts"
  ]
}
