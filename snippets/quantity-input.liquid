{%- comment -%}
  Sélecteur de quantité.
  Paramètres : id, value, min, max, name, form (id du formulaire), line (index de ligne panier)
{%- endcomment -%}

<quantity-input class="qty" data-qty>
  <button
    type="button"
    class="qty__btn"
    data-qty-step="-1"
    aria-label="{{ 'products.product.decrease_quantity' | t }}"
  >
    {% render 'icon', icon: 'minus' %}
  </button>

  <input
    class="qty__input"
    type="number"
    id="{{ id | default: 'Quantity' }}"
    name="{{ name | default: 'quantity' }}"
    value="{{ value | default: 1 }}"
    min="{{ min | default: 1 }}"
    {% if max %}max="{{ max }}"{% endif %}
    step="1"
    inputmode="numeric"
    aria-label="{{ 'products.product.quantity' | t }}"
    {% if form %}form="{{ form }}"{% endif %}
    {% if line %}data-cart-line="{{ line }}"{% endif %}
  >

  <button
    type="button"
    class="qty__btn"
    data-qty-step="1"
    aria-label="{{ 'products.product.increase_quantity' | t }}"
  >
    {% render 'icon', icon: 'plus' %}
  </button>
</quantity-input>
