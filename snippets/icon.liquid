{%- comment -%}
  Jeu d’icônes discrètes, trait 1,3 px.
  Usage : {% render 'icon', icon: 'cart' %} ou {% render 'icon', icon: 'star', class: 'is-filled' %}
{%- endcomment -%}

{%- liquid
  assign cls = class | default: ''
-%}

{%- case icon -%}
  {%- when 'search' -%}
    <svg class="icon icon--search {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6" stroke-linecap="round"/></svg>
  {%- when 'account' -%}
    <svg class="icon icon--account {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><circle cx="12" cy="9" r="3.4"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0" stroke-linecap="round"/><circle cx="12" cy="12" r="9.2"/></svg>
  {%- when 'cart' -%}
    <svg class="icon icon--cart {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M6 8h12l1 12H5z" stroke-linejoin="round"/><path d="M9 10V7a3 3 0 0 1 6 0v3" stroke-linecap="round"/></svg>
  {%- when 'close' -%}
    <svg class="icon icon--close {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="icon icon--chevron-right {{ cls }}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'chevron-left' -%}
    <svg class="icon icon--chevron-left {{ cls }}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="icon icon--chevron-down {{ cls }}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="m3 6 5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="icon icon--arrow-right {{ cls }}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M2 8h12M9 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'star' -%}
    <svg class="icon icon--star {{ cls }}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="m10 1 2.6 5.6 6 .8-4.4 4.2 1.1 6L10 14.8 4.7 17.6l1.1-6L1.4 7.4l6-.8z"/></svg>
  {%- when 'check' -%}
    <svg class="icon icon--check {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'shield' -%}
    <svg class="icon icon--shield {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><path d="M12 3 4 6v6c0 5 3.4 8.2 8 9 4.6-.8 8-4 8-9V6z" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'truck' -%}
    <svg class="icon icon--truck {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
  {%- when 'clock' -%}
    <svg class="icon icon--clock {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><path d="M12 7v5l4 2.5" stroke-linecap="round"/><circle cx="12" cy="12" r="9"/></svg>
  {%- when 'card' -%}
    <svg class="icon icon--card {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>
  {%- when 'leaf' -%}
