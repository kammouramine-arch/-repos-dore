  {%- when 'mail' -%}
    <svg class="icon icon--mail {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'phone' -%}
    <svg class="icon icon--phone {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><path d="M6 3h3l2 5-2.5 1.5a12 12 0 0 0 6 6L16 13l5 2v3a3 3 0 0 1-3 3A15 15 0 0 1 3 6a3 3 0 0 1 3-3z" stroke-linejoin="round"/></svg>
  {%- when 'pin' -%}
    <svg class="icon icon--pin {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.6"/></svg>
  {%- when 'briefcase' -%}
    <svg class="icon icon--briefcase {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><rect x="3" y="7" width="18" height="13" rx="3"/><path d="M9 7V5.5A2.5 2.5 0 0 1 11.5 3h1A2.5 2.5 0 0 1 15 5.5V7" stroke-linecap="round"/></svg>
  {%- when 'instagram' -%}
    <svg class="icon icon--instagram {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1.1" fill="currentColor" stroke="none"/></svg>
  {%- when 'youtube' -%}
    <svg class="icon icon--youtube {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="m10 9.5 5 2.5-5 2.5z" stroke-linejoin="round"/></svg>
  {%- when 'linkedin' -%}
    <svg class="icon icon--linkedin {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 10v7M8 7v.01M12 17v-4a2.5 2.5 0 0 1 5 0v4" stroke-linecap="round"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon icon--facebook {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M15 8h-1.5A1.5 1.5 0 0 0 12 9.5V12m-1.5 0h3m-1.5 0v5" stroke-linecap="round"/></svg>
  {%- when 'tiktok' -%}
    <svg class="icon icon--tiktok {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M14 4v10.5a3.5 3.5 0 1 1-3-3.46" stroke-linecap="round"/><path d="M14 4a5 5 0 0 0 5 5" stroke-linecap="round"/></svg>
  {%- when 'plus' -%}
    <svg class="icon icon--plus {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
  {%- when 'minus' -%}
    <svg class="icon icon--minus {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M5 12h14" stroke-linecap="round"/></svg>
  {%- when 'quote' -%}
    <svg class="icon icon--quote {{ cls }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M9 6c-3 1.6-4.5 4-4.5 7.2V18H10v-5H7.2c.1-1.9 1-3.3 2.6-4.2zm9 0c-3 1.6-4.5 4-4.5 7.2V18H19v-5h-2.8c.1-1.9 1-3.3 2.6-4.2z"/></svg>
