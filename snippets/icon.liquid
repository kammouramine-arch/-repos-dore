{%- comment -%}
  Icon library
  Usage: {% render 'icon', name: 'bag' %}
  Every icon shares a 24×24 box and a 1.25 stroke so they sit optically even
  next to type. Decorative by default (aria-hidden).
{%- endcomment -%}

{%- liquid
  assign fill = 'none'
  assign stroke = 'currentColor'
-%}

{%- capture paths -%}
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>
    {%- when 'bag' -%}
      <path d="M4.5 7.5h15l-1 12.5h-13z"/><path d="M8.75 10V7a3.25 3.25 0 0 1 6.5 0v3"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8.25" r="3.5"/><path d="M4.75 20c.6-3.9 3.6-6.25 7.25-6.25S18.65 16.1 19.25 20"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'menu' -%}
      <path d="M3.5 8h17M3.5 16h17"/>
    {%- when 'arrow-right' -%}
      <path d="M4.5 12h15M13.5 6l6 6-6 6"/>
    {%- when 'arrow-left' -%}
      <path d="M19.5 12h-15M10.5 6l-6 6 6 6"/>
    {%- when 'arrow-up-right' -%}
      <path d="M7 17L17 7M8.5 7H17v8.5"/>
    {%- when 'chevron-down' -%}
      <path d="M5.5 9l6.5 6.5L18.5 9"/>
    {%- when 'chevron-right' -%}
      <path d="M9 5.5l6.5 6.5L9 18.5"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'check' -%}
      <path d="M4.5 12.5l5 5 10-11"/>
    {%- when 'star' -%}
      <path d="M12 2.5l2.9 6.2 6.6.85-4.85 4.6 1.25 6.6L12 17.6l-5.9 3.15 1.25-6.6L2.5 9.55l6.6-.85z"/>
    {%- when 'drag' -%}
      <path d="M9.5 8L5.5 12l4 4M14.5 8l4 4-4 4"/>
    {%- when 'leaf' -%}
      <path d="M20 4c0 8.5-4.5 13-11 13H5.5C5.5 9.5 11 4 20 4z"/><path d="M4 20c2.5-4 5.5-6.5 9.5-8.5"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-9.6A4.4 4.4 0 0 1 12 7.7a4.4 4.4 0 0 1 7.5 2.7c0 5-7.5 9.6-7.5 9.6z"/>
    {%- when 'shield' -%}
      <path d="M12 3l7.5 3v6c0 4.5-3 7.6-7.5 9-4.5-1.4-7.5-4.5-7.5-9V6z"/><path d="M9 12l2.2 2.2L15.5 10"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.2l3.2 2"/>
    {%- when 'moon' -%}
      <path d="M20 14.2A8 8 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2z"/>
    {%- when 'wave' -%}
      <path d="M2.5 9.5c2-3 4-3 6 0s4 3 6 0 4-3 6 0"/><path d="M2.5 15.5c2-3 4-3 6 0s4 3 6 0 4-3 6 0"/>
    {%- when 'spark' -%}
      <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M18.5 16.5l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/>
    {%- when 'thermometer' -%}
      <path d="M14 14V5.5a2 2 0 1 0-4 0V14a4 4 0 1 0 4 0z"/>
    {%- when 'battery' -%}
      <rect x="2.5" y="8" width="16" height="8" rx="2"/><path d="M21.5 11v2M5.5 11v2M9 11v2"/>
    {%- when 'feather' -%}
      <path d="M19.5 4.5c-6 0-11 3.5-11 9.5v2.5h2.5c6 0 9.5-5 9.5-11z"/><path d="M4.5 19.5L11 13"/>
    {%- when 'award' -%}
      <circle cx="12" cy="9.5" r="5.5"/><path d="M8.5 14.2L7 21l5-2.5L17 21l-1.5-6.8"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 10h4l4 3v2.5h-8z"/><circle cx="7" cy="17.5" r="2"/><circle cx="17" cy="17.5" r="2"/>
    {%- when 'refresh' -%}
      <path d="M20 12a8 8 0 1 1-2.4-5.7"/><path d="M20 4v4.5h-4.5"/>
    {%- when 'headset' -%}
      <path d="M4.5 14v-2a7.5 7.5 0 0 1 15 0v2"/><rect x="2.5" y="13" width="4" height="6" rx="1.5"/><rect x="17.5" y="13" width="4" height="6" rx="1.5"/><path d="M19.5 19v.5a3 3 0 0 1-3 3H13"/>
    {%- when 'lock' -%}
      <rect x="4.5" y="10" width="15" height="10" rx="2"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17 6.6v.01"/>
    {%- when 'facebook' -%}
      <path d="M14.5 8.5h2.5V5h-2.5c-2 0-3.5 1.5-3.5 3.5V11H8.5v3.5H11V21h3.5v-6.5H17l.5-3.5h-3V9c0-.3.2-.5.5-.5z"/>
    {%- when 'tiktok' -%}
      <path d="M14.5 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14.5 6.5A4.5 4.5 0 0 0 19 11"/>
    {%- when 'youtube' -%}
      <rect x="2.5" y="6" width="19" height="12" rx="3.5"/><path d="M10.5 9.5l4.5 2.5-4.5 2.5z"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M9.5 20l2-8"/><path d="M9 10.5c0-2 1.5-3.2 3.2-3.2 1.8 0 3.1 1.1 3.1 2.9 0 2.2-1.2 3.9-2.9 3.9-.9 0-1.6-.7-1.4-1.6"/>
    {%- when 'linkedin' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.5V17M8 7.5v.01M12 17v-3.6c0-1.3.8-2.4 2.2-2.4S16 12.1 16 13.4V17"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8.5"/>
  {%- endcase -%}
{%- endcapture -%}

{%- if name == 'star' -%}
  {%- assign fill = 'currentColor' -%}
  {%- assign stroke = 'none' -%}
{%- endif -%}

<svg
  class="icon icon--{{ name }}"
  viewBox="0 0 24 24"
  fill="{{ fill }}"
  stroke="{{ stroke }}"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>{{ paths }}</svg>
