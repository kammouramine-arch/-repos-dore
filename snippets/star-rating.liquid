{%- comment -%}
  Note en étoiles à partir d’un métachamp rating (app d’avis).
  Paramètres : rating (métachamp), count, compact
{%- endcomment -%}

{%- liquid
  assign value = rating.value.rating | default: rating.value | default: 0 | times: 1.0
  assign scale = rating.value.scale_max | default: 5
  assign rounded = value | round
  assign total = count.value | default: count | default: 0
-%}

{%- if value > 0 -%}
  <span class="rating{% if compact %} rating--compact{% endif %}">
    <span class="rating__stars" role="img" aria-label="{{ 'general.accessibility.star_reviews_info' | t: rating_value: value, rating_max: scale }}">
      {%- for i in (1..scale) -%}
        {%- if i > rounded -%}
          {% render 'icon', icon: 'star', class: 'is-empty' %}
        {%- else -%}
          {% render 'icon', icon: 'star' %}
        {%- endif -%}
      {%- endfor -%}
    </span>
    <span class="rating__text">
      {{ value }}{% if total > 0 %} — {{ 'general.accessibility.total_reviews' | t: count: total }}{% endif %}
    </span>
  </span>
{%- endif -%}
