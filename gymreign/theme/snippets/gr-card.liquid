{%- comment -%}
  Product card. Params: product, index (for reveal stagger)
{%- endcomment -%}
{%- assign short_title = product.title | remove: 'GYMREIGN — ' | remove: ' — Chapter 001' -%}
{%- assign color_opt_index = -1 -%}
{%- for opt in product.options_with_values -%}
  {%- if opt.name == 'Color' or opt.name == 'Colour' -%}{%- assign color_opt_index = forloop.index0 -%}{%- endif -%}
{%- endfor -%}
<article class="card reveal" style="--i:{{ index | default: 0 }}">
  <div class="card__media">
    {%- if product.media.size > 1 -%}
      <img class="card__alt" src="{{ product.media[1] | image_url: width: 720 }}"
           srcset="{{ product.media[1] | image_url: width: 480 }} 480w, {{ product.media[1] | image_url: width: 720 }} 720w"
           sizes="(min-width: 750px) 25vw, 50vw" alt="" loading="lazy" width="720" height="900">
    {%- endif -%}
    <img class="card__main" src="{{ product.featured_media | image_url: width: 720 }}"
         srcset="{{ product.featured_media | image_url: width: 480 }} 480w, {{ product.featured_media | image_url: width: 720 }} 720w, {{ product.featured_media | image_url: width: 1080 }} 1080w"
         sizes="(min-width: 750px) 25vw, 50vw"
         alt="{{ short_title | escape }} — GYMREIGN Chapter 001" loading="lazy" width="720" height="900">
  </div>
  <div class="card__body">
    <div class="card__row">
      <h3 class="card__title"><a class="card__link" href="{{ product.url }}">{{ short_title }}</a></h3>
      <span class="card__price t-num">{{ product.price | money }}</span>
    </div>
    <div class="card__meta">
      {%- if color_opt_index > -1 -%}
        {%- assign colors = product.options_with_values[color_opt_index].values -%}
        <div class="sw-row" aria-label="{{ colors.size }} colours">
          {%- for c in colors limit: 5 -%}
            <span class="sw" style="background:{% render 'gr-swatch-hex', color: c %}" title="{{ c }}"></span>
          {%- endfor -%}
          {%- if colors.size > 5 -%}<span class="sw-more">+{{ colors.size | minus: 5 }}</span>{%- endif -%}
        </div>
        <span class="t-micro">{{ colors.size }} colours</span>
      {%- endif -%}
    </div>
  </div>
</article>
