{%- comment -%}
  Site furniture that frames the whole experience: a scroll progress hairline,
  technical corner marks, and a section index. All decorative — hidden from
  assistive tech and from anyone who has asked for less motion.
{%- endcomment -%}
<div class="chrome" aria-hidden="true">
  <div class="chrome__bar"><span class="chrome__bar-fill" data-scroll-bar></span></div>
  <span class="chrome__tick chrome__tick--tl"></span>
  <span class="chrome__tick chrome__tick--tr"></span>
  <span class="chrome__tick chrome__tick--bl"></span>
  <span class="chrome__tick chrome__tick--br"></span>
  <span class="chrome__edge chrome__edge--l">EARN YOUR REIGN</span>
  <span class="chrome__edge chrome__edge--r" data-scroll-pct>000</span>
</div>
