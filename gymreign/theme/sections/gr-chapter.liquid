{%- assign col = collections[section.settings.collection] | default: collections['chapter-001'] -%}
<section class="on-light band">
  <div class="shell">
    <div class="chapter-head reveal">
      <div>
        <p class="t-label t-faint eyebrow">The current chapter</p>
        <h2 class="t-h1">Chapter 001<br>Ascension</h2>
      </div>
      <div style="max-width:22rem">
        <p class="t-small t-muted">Five pieces. One standard. Each carries the crowned mark once —
          placed, measured, and left alone.</p>
        <a class="t-label link-line" style="display:inline-block;margin-top:1.1rem" href="{{ col.url }}">View the chapter</a>
      </div>
    </div>
    <div class="grid--pad grid grid--4">
      {%- for product in col.products limit: 4 -%}
        {% render 'gr-card', product: product, index: forloop.index0 %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Chapter grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" }
  ],
  "presets": [{ "name": "Chapter grid" }]
}
{% endschema %}
