<section class="on-light plp-hero">
  <div class="shell">
    <p class="t-label t-faint eyebrow">The catalogue</p>
    <h1 class="t-h1">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="t-lede t-muted measure" style="margin-top:1.2rem">{{ collection.description | strip_html }}</p>
    {%- endif -%}

    <div class="plp-bar">
      <span class="t-label t-faint">{{ collection.products_count }} pieces</span>
      <form method="get" id="sortform">
        <label class="t-micro t-faint" for="sortsel">Sort</label>
        <select id="sortsel" name="sort_by" onchange="this.form.submit()">
          {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
          <option value="manual" {% if current_sort == 'manual' %}selected{% endif %}>Chapter order</option>
          <option value="price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price — low</option>
          <option value="price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price — high</option>
          <option value="title-ascending" {% if current_sort == 'title-ascending' %}selected{% endif %}>A–Z</option>
        </select>
      </form>
    </div>
  </div>
</section>

<section class="on-light band-s">
  <div class="shell">
    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <div class="grid grid--pad grid--3">
          {%- for product in collection.products -%}
            {% render 'gr-card', product: product, index: forloop.index0 %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="util-hero">
          <p class="t-label t-faint">Nothing here yet</p>
          <h2 class="t-h2">This chapter has not opened.</h2>
          <a class="btn btn--ghost" href="/collections/chapter-001">Return to Chapter 001</a>
        </div>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}
        <nav class="plp-bar" aria-label="Pagination" style="margin-top:2.5rem">
          {%- if paginate.previous -%}<a class="t-label link-line" href="{{ paginate.previous.url }}">Previous</a>{%- else -%}<span></span>{%- endif -%}
          <span class="t-micro t-faint">{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="t-label link-line" href="{{ paginate.next.url }}">Next</a>{%- else -%}<span></span>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
