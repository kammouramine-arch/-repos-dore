<section class="on-dark specs">
  <div class="specs__grid">
    {%- for block in section.blocks -%}
      <div class="specs__cell reveal" style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <p class="specs__num">{{ block.settings.value }}<span class="specs__unit"> {{ block.settings.unit }}</span></p>
        <p class="t-label t-faint" style="margin-top:.9rem">{{ block.settings.label }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Specification band",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "350" },
        { "type": "text", "id": "unit", "label": "Unit", "default": "GSM" },
        { "type": "text", "id": "label", "label": "Label", "default": "Hoodie weight" }
      ]
    }
  ],
  "presets": [{
    "name": "Specification band",
    "blocks": [
      { "type": "stat", "settings": { "value": "350", "unit": "GSM", "label": "The Hoodie" } },
      { "type": "stat", "settings": { "value": "339", "unit": "GSM", "label": "The Jogger" } },
      { "type": "stat", "settings": { "value": "240", "unit": "GSM", "label": "The Tee — organic" } },
      { "type": "stat", "settings": { "value": "001", "unit": "CH", "label": "Never reprinted" } }
    ]
  }]
}
{% endschema %}
