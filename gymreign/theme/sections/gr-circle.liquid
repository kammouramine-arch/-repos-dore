<section class="on-dark circle">
  <div class="shell circle__in">
    <div class="circle__lead reveal">
      <p class="t-micro t-faint">{{ section.settings.eyebrow }}</p>
      <h2 class="circle__title">{{ section.settings.title }}</h2>
    </div>

    <div class="circle__panel reveal" style="--i:1">
      <p class="t-body t-muted circle__copy">{{ section.settings.copy }}</p>

      <ul class="circle__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="t-num circle__idx">{{ forloop.index | prepend: '0' }}</span>
            <span class="t-small">{{ block.settings.item }}</span>
          </li>
        {%- endfor -%}
      </ul>

      {%- form 'customer', class: 'circle__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="circle__ok" role="status">
            <span class="t-label">You stand in the first circle.</span>
            <span class="t-small t-muted">Watch for Chapter 002.</span>
          </p>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="newsletter,first-circle">
          <div class="field-line">
            <label class="vh" for="circle-email">Email address</label>
            <input id="circle-email" type="email" name="contact[email]" required autocomplete="email"
                   placeholder="Email address" spellcheck="false">
            <button type="submit" class="field-line__go" aria-label="Request access">
              {% render 'gr-icon', name: 'arrow' %}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="circle__err t-small" role="alert">That address didn’t take. Check it and try again.</p>
          {%- else -%}
            <p class="t-micro t-faint circle__note">{{ section.settings.note }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "First circle",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Access" },
    { "type": "text", "id": "title", "label": "Title", "default": "The First Circle" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Chapters are numbered, opened once and never reprinted. The first circle is told before the doors move — in either direction." },
    { "type": "text", "id": "note", "label": "Note", "default": "Two or three sendings a year. Unsubscribe in one click." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [{ "type": "text", "id": "item", "label": "Item", "default": "Item" }]
    }
  ],
  "presets": [{
    "name": "First circle",
    "blocks": [
      { "type": "item", "settings": { "item": "First sight of every chapter before it opens" } },
      { "type": "item", "settings": { "item": "Notice before a chapter closes for good" } },
      { "type": "item", "settings": { "item": "No discounts — the price is the price" } }
    ]
  }]
}
{% endschema %}
