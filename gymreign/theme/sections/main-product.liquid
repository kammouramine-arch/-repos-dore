{%- assign short_title = product.title | remove: 'GYMREIGN — ' | remove: ' — Chapter 001' -%}
{%- assign current = product.selected_or_first_available_variant -%}
<section class="on-dark band-s" data-product>
  <script type="application/json" data-product-json>
    {
      "options": {{ product.options | json }},
      "variants": [
        {%- for v in product.variants -%}
        {
          "id": {{ v.id }},
          "price": {{ v.price }},
          "available": {{ v.available }},
          "options": {{ v.options | json }},
          "featured_media_position": {{ v.featured_media.position | default: 'null' }}
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>

  <div class="shell pdp">
    <div class="pdp__gallery" aria-label="Product imagery">
      {%- for media in product.media -%}
        <figure class="pdp__shot">
          <img src="{{ media | image_url: width: 1200 }}"
               srcset="{{ media | image_url: width: 720 }} 720w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1800 }} 1800w"
               sizes="(min-width: 990px) 55vw, 92vw"
               alt="{{ media.alt | default: short_title | escape }}"
               {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
               width="1200" height="1500">
        </figure>
      {%- endfor -%}
    </div>

    <div class="pdp__info">
      <p class="t-label t-faint pdp__vendor">GYMREIGN — Chapter 001</p>
      <h1 class="t-h2 pdp__title">{{ short_title }}</h1>
      <p class="pdp__price" data-price>{{ current.price | money }}</p>
      <p class="t-micro pdp__tax">Taxes included · tracked delivery</p>

      {%- form 'product', product, data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current.id }}">

        {%- for option in product.options_with_values -%}
          {%- assign idx = forloop.index0 -%}
          {%- assign is_color = false -%}
          {%- if option.name == 'Color' or option.name == 'Colour' -%}{%- assign is_color = true -%}{%- endif -%}
          <fieldset class="opt" style="border:0;padding:0;margin-top:1.8rem">
            <legend class="visually-hidden" style="position:absolute;left:-999em">{{ option.name }}</legend>
            <div class="opt__head">
              <span class="t-label t-faint">{{ option.name }}</span>
              <span class="t-label opt__val" data-opt-val="{{ idx }}">{{ option.selected_value }}</span>
            </div>
            <div class="optgrid {% if is_color %}opt-color{% else %}opt-size{% endif %}">
              {%- for value in option.values -%}
                <input type="radio" id="opt-{{ idx }}-{{ forloop.index0 }}" name="option-{{ idx }}"
                       value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                <label for="opt-{{ idx }}-{{ forloop.index0 }}" {% if is_color %}title="{{ value }}"{% endif %}>
                  {%- if is_color -%}
                    <span class="sw sw--lg" style="background:{% render 'gr-swatch-hex', color: value %}"></span>
                    <span class="visually-hidden" style="position:absolute;left:-999em">{{ value }}</span>
                  {%- else -%}
                    {{ value }}
                  {%- endif -%}
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}

        <div class="pdp__buy" data-buy-box>
          <button type="submit" class="btn btn--solid btn--wide" data-atc data-label="Add to bag">Add to bag</button>
          <div class="pdp__note t-micro">
            <span>Free shipping over €120</span>
            <span>30-day returns</span>
            <span>Secure checkout</span>
          </div>
        </div>
      {%- endform -%}

      <div class="acc">
        {%- if product.description != blank -%}
        <details open>
          <summary class="t-label">The piece</summary>
          <div class="acc__body">{{ product.description }}</div>
        </details>
        {%- endif -%}
        <details>
          <summary class="t-label">Size &amp; fit</summary>
          <div class="acc__body">
            <p>Cut relaxed. If you sit between sizes, size down for the intended fit — the silhouette carries the room.</p>
            <p><a class="link-line" href="/pages/size-guide">Full size guide</a></p>
          </div>
        </details>
        <details>
          <summary class="t-label">Shipping &amp; returns</summary>
          <div class="acc__body">
            <p>Made to order — each piece enters production when you claim it. Allow up to 10 days of
            production before dispatch, then tracked delivery. Complimentary worldwide shipping on
            orders over €120; €9.90 below.</p>
            <p>30 days to return, unworn, from delivery. <a class="link-line" href="/pages/returns">Returns</a> · <a class="link-line" href="/pages/shipping">Shipping</a></p>
          </div>
        </details>
        <details>
          <summary class="t-label">Care</summary>
          <div class="acc__body">
            <p>Wash cold, inside out. Hang dry. No bleach, no tumble. The mark outlasts the season if you let it.</p>
          </div>
        </details>
      </div>
    </div>
  </div>

  <div class="sticky-atc" data-sticky-atc>
    <div>
      <p class="t-micro t-faint">{{ short_title }}</p>
      <p class="t-num t-small" data-price>{{ current.price | money }}</p>
    </div>
    <button type="button" class="btn btn--solid" data-atc data-label="Add to bag">Add to bag</button>
  </div>
</section>

{%- comment -%} Complete the Reign {%- endcomment -%}
{%- assign chapter = collections['chapter-001'] -%}
{%- if chapter.products.size > 1 -%}
<section class="on-light band-s">
  <div class="shell">
    <p class="t-label t-faint eyebrow reveal">Complete the reign</p>
    <div class="grid grid--pad grid--4">
      {%- assign shown = 0 -%}
      {%- for rec in chapter.products -%}
        {%- if rec.id != product.id and shown < 4 -%}
          {%- assign shown = shown | plus: 1 -%}
          {% render 'gr-card', product: rec, index: shown %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} Product structured data {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ short_title | json }},
  "brand": { "@type": "Brand", "name": "GYMREIGN" },
  "image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "url": {{ request.origin | append: product.url | json }},
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
    "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
  }
}
</script>

{% schema %}
{ "name": "Product", "settings": [] }
{% endschema %}
