{%- assign short_title = product.title | remove: 'GYMREIGN — ' | remove: ' — Chapter 001' -%}
{%- assign current = product.selected_or_first_available_variant | default: product.variants.first -%}

{%- comment -%} Which option carries colour, and which colour is on screen now. {%- endcomment -%}
{%- assign color_idx = -1 -%}
{%- for opt in product.options -%}
  {%- assign lo = opt | downcase -%}
  {%- if lo == 'color' or lo == 'colour' -%}{%- assign color_idx = forloop.index0 -%}{%- endif -%}
{%- endfor -%}
{%- assign current_color = '' -%}
{%- if color_idx > -1 and current -%}{%- assign current_color = current.options[color_idx] -%}{%- endif -%}

{%- comment -%}
  Availability is SERVER-AUTHORITATIVE.
  Liquid decides the button state and renders it. JavaScript may only refine it after a
  positive variant match. Any parse failure, unmatched combination or missing data leaves
  the server's purchasable state intact — a false "Sold out" must never be possible.
{%- endcomment -%}
{%- assign can_buy = false -%}
{%- if current and current.available -%}{%- assign can_buy = true -%}{%- endif -%}

<section class="on-dark pdp-section" data-product
         data-product-available="{% if product.available %}true{% else %}false{% endif %}">

  <div class="shell pdp">
    <div class="pdp__gallery" aria-label="{{ short_title | escape }} imagery">
      {%- comment -%}
        Each image now carries its colourway in its alt text (written into Shopify,
        so it serves accessibility and search as well as this filter). Byte-identical
        duplicates supplied by the print partner are listed in custom.gallery_skip.
      {%- endcomment -%}
      {%- assign skip = product.metafields.custom.gallery_skip | default: '' | append: ',' -%}
      {%- assign shown = 0 -%}
      {%- for media in product.media -%}
        {%- assign mid = media.id | append: ',' -%}
        {%- unless skip contains mid -%}
          {%- assign shot_color = '' -%}
          {%- if media.alt contains ' — ' -%}
            {%- assign shot_color = media.alt | split: ' — ' | last | strip -%}
          {%- endif -%}
          {%- assign shot_on = true -%}
          {%- if shot_color != '' and current_color != '' and shot_color != current_color -%}
            {%- assign shot_on = false -%}
          {%- endif -%}
          {%- if shot_on -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
          <figure class="pdp__shot" data-media-position="{{ forloop.index }}"
                  data-colors="{{ shot_color | escape }}"{% unless shot_on %} hidden{% endunless %}>
            <img src="{{ media | image_url: width: 1200 }}"
                 srcset="{{ media | image_url: width: 720 }} 720w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1800 }} 1800w"
                 sizes="(min-width: 990px) 54vw, 92vw"
                 alt="{{ media.alt | default: short_title | escape }}"
                 {% if shown == 1 and shot_on %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                 width="1200" height="1500">
          </figure>
        {%- endunless -%}
      {%- endfor -%}
    </div>

    <div class="pdp__info">
      <div class="pdp__head">
        <p class="t-micro t-faint">Chapter 001 — Ascension</p>
        <h1 class="pdp__title">{{ short_title }}</h1>
        <div class="pdp__pricerow">
          <span class="pdp__price t-num" data-price>{{ current.price | money }}</span>
          <span class="t-micro t-faint">Taxes included</span>
        </div>
      </div>

      {%- form 'product', product, data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

        {%- comment -%}
          Server-authoritative variant picker.

          Every option value is a link to a REAL variant id, resolved here by Liquid at
          render time against product.variants. Choosing one navigates (or, with JS, swaps
          this section via the Section Rendering API) and Shopify re-renders with that
          variant selected. Nothing on the client decides which variant is chosen, whether
          it exists, or whether it can be bought.

          For each value we look for the variant that keeps every other option as it is.
          If that exact combination does not exist we fall back to the first variant that
          uses the value at all, so the customer moves to a valid combination instead of
          hitting a dead end. A value no variant uses is rendered inert.
        {%- endcomment -%}
        {%- for option in product.options_with_values -%}
          {%- assign idx = forloop.index0 -%}
          {%- assign is_color = false -%}
          {%- assign lname = option.name | downcase -%}
          {%- if lname == 'color' or lname == 'colour' -%}{%- assign is_color = true -%}{%- endif -%}
          <fieldset class="opt {% if is_color %}opt--color{% endif %}">
            <legend class="vh">{{ option.name }}</legend>
            <div class="opt__head">
              <span class="t-micro t-faint">{% if is_color %}Colour{% else %}{{ option.name }}{% endif %}</span>
              {%- if is_color -%}
                <span class="t-micro opt__val">{{ option.selected_value }}</span>
              {%- else -%}
                <a class="t-micro t-faint link-line" href="/pages/size-guide">Size guide</a>
              {%- endif -%}
            </div>
            <div class="optgrid {% if is_color %}opt-color{% else %}opt-size{% endif %}">
              {%- for value in option.values -%}
                {%- assign exact = nil -%}
                {%- assign loose = nil -%}
                {%- for v in product.variants -%}
                  {%- if v.options[idx] == value -%}
                    {%- if loose == nil -%}{%- assign loose = v -%}{%- endif -%}
                    {%- assign same = true -%}
                    {%- for other in product.options_with_values -%}
                      {%- assign oi = forloop.index0 -%}
                      {%- unless oi == idx -%}
                        {%- unless v.options[oi] == current.options[oi] -%}{%- assign same = false -%}{%- endunless -%}
                      {%- endunless -%}
                    {%- endfor -%}
                    {%- if same and exact == nil -%}{%- assign exact = v -%}{%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- assign target = exact | default: loose -%}
                {%- assign chosen = false -%}
                {%- if option.selected_value == value -%}{%- assign chosen = true -%}{%- endif -%}

                {%- if target -%}
                  <a class="optval{% if chosen %} is-on{% endif %}{% unless target.available %} is-off{% endunless %}"
                     href="{{ product.url }}?variant={{ target.id }}"
                     data-variant-link
                     {% if chosen %}aria-current="true"{% endif %}
                     {% if is_color %}title="{{ value | escape }}"{% endif %}>
                    {%- if is_color -%}
                      <span class="sw sw--lg" style="background:{% render 'gr-swatch-hex', color: value %}"></span>
                      <span class="vh">{{ value }}{% unless target.available %} — sold out{% endunless %}</span>
                    {%- else -%}
                      <span>{{ value }}</span>
                    {%- endif -%}
                  </a>
                {%- else -%}
                  <span class="optval is-void" aria-disabled="true"
                        {% if is_color %}title="{{ value | escape }}"{% endif %}>
                    {%- if is_color -%}
                      <span class="sw sw--lg" style="background:{% render 'gr-swatch-hex', color: value %}"></span>
                      <span class="vh">{{ value }} — not made in this chapter</span>
                    {%- else -%}
                      <span>{{ value }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}

        <div class="pdp__buy" data-buy-box>
          <button type="submit" class="btn btn--solid btn--wide btn--atc"
                  data-atc data-label="Add to bag"{% unless can_buy %} disabled{% endunless %}>
            <span data-atc-text>{% if can_buy %}Add to bag{% else %}Sold out{% endif %}</span>
          </button>
        </div>
      {%- endform -%}

      <ul class="pdp__assure">
        <li><span class="t-micro">Free shipping over €120</span></li>
        <li><span class="t-micro">30-day returns</span></li>
        <li><span class="t-micro">Made to order — dispatch within 10 days</span></li>
      </ul>

      <div class="acc">
        {%- if product.description != blank -%}
        <details open>
          <summary><span class="t-label">The piece</span></summary>
          <div class="acc__body">{{ product.description }}</div>
        </details>
        {%- endif -%}
        <details>
          <summary><span class="t-label">Size &amp; fit</span></summary>
          <div class="acc__body">
            <p>Cut relaxed. If you sit between sizes, size down for the intended fit — the
            silhouette carries the room.</p>
            <p><a class="link-line" href="/pages/size-guide">Full size guide</a></p>
          </div>
        </details>
        <details>
          <summary><span class="t-label">Shipping &amp; returns</span></summary>
          <div class="acc__body">
            <p>Made to order — each piece enters production when you claim it. Allow up to 10
            days of production before dispatch, then tracked delivery. Complimentary worldwide
            shipping over €120; €9.90 below.</p>
            <p>30 days to return, unworn, from delivery.
            <a class="link-line" href="/pages/returns">Returns</a> ·
            <a class="link-line" href="/pages/shipping">Shipping</a></p>
          </div>
        </details>
        <details>
          <summary><span class="t-label">Care</span></summary>
          <div class="acc__body">
            <p>Wash cold, inside out. Hang dry. No bleach, no tumble.</p>
          </div>
        </details>
      </div>
    </div>
  </div>

  <div class="sticky-atc" data-sticky-atc>
    <div class="sticky-atc__meta">
      <p class="t-micro t-faint">{{ short_title }}</p>
      <p class="t-num t-small" data-price>{{ current.price | money }}</p>
    </div>
    <button type="button" class="btn btn--solid btn--atc" data-atc data-label="Add to bag"
            {% unless can_buy %}disabled{% endunless %}>
      <span data-atc-text>{% if can_buy %}Add to bag{% else %}Sold out{% endif %}</span>
    </button>
  </div>
</section>

{%- assign chapter = collections['chapter-001'] -%}
{%- if chapter.products.size > 1 -%}
<section class="on-light band-s">
  <div class="shell">
    <div class="sec-head reveal">
      <h2 class="t-h2">Complete the reign</h2>
      <a class="t-micro link-line" href="{{ chapter.url }}">The full chapter</a>
    </div>
    <div class="grid grid--pad grid--4">
      {%- assign shown = 0 -%}
      {%- for rec in chapter.products -%}
        {%- if rec.id != product.id and shown < 4 -%}
          {%- assign shown = shown | plus: 1 -%}
          {% render 'gr-card', product: rec, index: shown %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ short_title | json }},
  "brand": { "@type": "Brand", "name": "GYMREIGN" },
  "image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "url": {{ request.origin | append: product.url | json }},
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
    "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
    "offerCount": {{ product.variants.size | json }},
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
  }
}
</script>

{% schema %}
{ "name": "Product", "settings": [] }
{% endschema %}
