{%- comment -%}
  Built to a number.

  The category sells adjectives; we publish the measurement. Each beat strikes
  the standard the category settles for and states ours at full scale. Every
  figure here is a real, published specification of the pieces in Chapter 001.
{%- endcomment -%}
<section class="ctr on-dark">
  <div class="shell">
    <div class="sec-head reveal">
      <div>
        <p class="t-micro t-faint">{{ section.settings.eyebrow }}</p>
        <h2 class="t-h2">{{ section.settings.title }}</h2>
      </div>
      <p class="t-small t-muted sec-head__note">{{ section.settings.note }}</p>
    </div>

    <div class="ctr__list">
      {%- for block in section.blocks -%}
        <article class="ctr__row" data-ctr {{ block.shopify_attributes }}>
          <p class="ctr__idx t-num">{{ forloop.index | prepend: '00' | slice: -2, 2 }}</p>
          <div class="ctr__body">
            <p class="ctr__against">
              <span class="ctr__strike">{{ block.settings.against }}</span>
              <span class="t-micro ctr__against-note">{{ block.settings.against_note }}</span>
            </p>
            <p class="ctr__figure t-num">
              {{ block.settings.figure }}<span class="ctr__unit">{{ block.settings.unit }}</span>
            </p>
            <p class="ctr__head">{{ block.settings.heading }}</p>
            <p class="t-small t-muted ctr__copy">{{ block.settings.copy }}</p>
            {%- if block.settings.link != blank -%}
              <a class="t-micro link-line" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Built to a number",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Built to a number" },
    { "type": "text", "id": "title", "label": "Title", "default": "We publish the measurement." },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Every figure below is printed on the product page before you buy. Nothing here is a claim we cannot put a number against." }
  ],
  "blocks": [
    {
      "type": "beat",
      "name": "Beat",
      "settings": [
        { "type": "text", "id": "against", "label": "Struck value", "default": "280 GSM" },
        { "type": "text", "id": "against_note", "label": "Struck note", "default": "What the price band settles for" },
        { "type": "text", "id": "figure", "label": "Figure", "default": "350" },
        { "type": "text", "id": "unit", "label": "Unit", "default": "GSM" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "The weight" },
        { "type": "textarea", "id": "copy", "label": "Copy", "default": "Copy" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "See the piece" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Built to a number" }]
}
{% endschema %}
