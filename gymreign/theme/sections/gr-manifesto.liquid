<section class="on-light band">
  <div class="shell manif">
    <p class="t-label t-faint eyebrow reveal">{{ section.settings.eyebrow }}</p>
    <h2 class="manif__line reveal" style="--i:1">{{ section.settings.line_1 }}</h2>
    <div class="manif__foot reveal" style="--i:2">
      <p class="t-label manif__sign">{{ section.settings.sign }}</p>
      <p class="t-small t-muted manif__support">{{ section.settings.line_2 }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Manifesto",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The position" },
    { "type": "text", "id": "line_1", "label": "Statement", "default": "We do not sell motivation. We make the uniform for the work." },
    { "type": "textarea", "id": "line_2", "label": "Support", "default": "Position is earned — in the gym, and in how a garment is made. So we publish weights and measurements where the category publishes adjectives, and we retire every chapter for good." },
    { "type": "text", "id": "sign", "label": "Signature", "default": "Earn your reign." }
  ],
  "presets": [{ "name": "Manifesto" }]
}
{% endschema %}
