{%- comment -%}
  Replaces the old "reserved" placeholder grid. Every tile carries real, verified
  content — a published number, a real garment image, and a reason.
{%- endcomment -%}
<section class="on-light band">
  <div class="shell">
    <div class="sec-head reveal">
      <div>
        <p class="t-micro t-faint">{{ section.settings.eyebrow }}</p>
        <h2 class="t-h2">{{ section.settings.title }}</h2>
      </div>
      <p class="t-small t-muted sec-head__note">{{ section.settings.note }}</p>
    </div>

    <div class="inside">
      {%- for block in section.blocks -%}
        {%- assign p = all_products[block.settings.product] -%}
        <article class="inside__card reveal" style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="inside__media">
            {%- if p and p.featured_media -%}
              <img src="{{ p.featured_media | image_url: width: 900 }}"
                   srcset="{{ p.featured_media | image_url: width: 600 }} 600w, {{ p.featured_media | image_url: width: 900 }} 900w"
                   sizes="(min-width: 750px) 32vw, 92vw"
                   alt="{{ block.settings.heading | escape }}" loading="lazy" width="900" height="1125">
            {%- endif -%}
            <span class="inside__figure t-num">{{ block.settings.figure }}<span class="inside__unit">{{ block.settings.unit }}</span></span>
          </div>
          <div class="inside__body">
            <h3 class="inside__heading">{{ block.settings.heading }}</h3>
            <p class="t-small t-muted">{{ block.settings.copy }}</p>
            {%- if block.settings.link != blank -%}
              <a class="t-micro link-line inside__link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Inside the chapter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the chapter" },
    { "type": "text", "id": "title", "label": "Title", "default": "Built to a number." },
    { "type": "textarea", "id": "note", "label": "Note", "default": "The category sells adjectives. We publish the measurement, then build to it — and retire the chapter when it closes." }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "product", "id": "product", "label": "Product image" },
        { "type": "text", "id": "figure", "label": "Figure", "default": "350" },
        { "type": "text", "id": "unit", "label": "Unit", "default": "GSM" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "The weight" },
        { "type": "textarea", "id": "copy", "label": "Copy", "default": "Copy" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "See the piece" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Inside the chapter" }]
}
{% endschema %}
