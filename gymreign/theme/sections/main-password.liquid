<section class="util-hero" style="min-height:100svh">
  <img src="{{ 'gr-mark-chrome-sm.png' | asset_url }}" alt="GYMREIGN" width="150" height="151" style="margin:0 auto">
  <p class="t-label t-faint">GYMREIGN — Chapter 001</p>
  <h1 class="t-h1">The house is not yet open.</h1>
  <p class="t-lede t-muted measure" style="margin:0 auto">Five pieces. Numbered. Never reprinted. The doors open soon.</p>
  {%- form 'storefront_password' -%}
    <div style="display:flex;border:1px solid var(--d-line);max-width:24rem;margin:1.5rem auto 0">
      <input type="password" name="password" placeholder="Password" aria-label="Password"
             style="flex:1;min-width:0;background:transparent;border:0;color:var(--d-ink);padding:0 1.2rem;min-height:52px">
      <button type="submit" class="btn btn--solid" style="border:0">Enter</button>
    </div>
    {%- if form.errors -%}<p class="form-err">Wrong password.</p>{%- endif -%}
  {%- endform -%}
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
