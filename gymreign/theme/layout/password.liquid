<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0E0F11">
  <title>{{ shop.name }}</title>
  <meta name="robots" content="noindex">
  <link rel="icon" type="image/png" href="{{ 'gr-favicon.png' | asset_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900&family=IBM+Plex+Mono:wght@400;500&display=swap">
  {{ 'gr.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="on-dark">
  <main>{{ content_for_layout }}</main>
</body>
</html>
