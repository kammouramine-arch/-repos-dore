# ─────────────────────────────────────────────────────────────────────────────
# CLIENT (safe to ship — read by app.config.ts and bundled into the app)
# ─────────────────────────────────────────────────────────────────────────────
# Supabase project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Supabase "anon" / publishable key. Safe on device: every table is protected by RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Set to "false" to disable product analytics entirely at build time.
EXPO_PUBLIC_ANALYTICS_ENABLED=true
# Optional: EAS project id for builds and push notifications.
EAS_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER — set with `supabase secrets set KEY=value`. NEVER put these in the app.
# ─────────────────────────────────────────────────────────────────────────────
# Anthropic API key used by the ai-chat edge function. Required for the assistant.
ANTHROPIC_API_KEY=
# What the assistant calls itself. Defaults to the brand name.
AI_NAME=
# Set to "false" to disable the server-side refusal fallback beta.
AI_REFUSAL_FALLBACK=true

# ── Model routing (optional) ─────────────────────────────────────────────────
# Models are chosen per subscription tier by the catalogue in
# supabase/functions/_shared/plans.ts. These override it per environment without a
# release; the same values can also be set in app_config.plans (see docs/BILLING.md).
AI_MODEL_FREE=
AI_MODEL_PLUS=
AI_MODEL_PRO=
AI_MODEL_ULTRA=
AI_EFFORT_FREE=
AI_EFFORT_PLUS=
AI_EFFORT_PRO=
AI_EFFORT_ULTRA=
# Model used for advanced work (deep analysis, 90-day plans) on plans that include it.
AI_MODEL_PRO_ADVANCED=

# ── Store subscriptions ──────────────────────────────────────────────────────
# Apple — App Store Server API (StoreKit 2). App Store Connect → Users and Access →
# Integrations → In-App Purchase, then create a key and download the .p8 once.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# The .p8 contents. Keep the newlines; set it with:
#   supabase secrets set APPLE_PRIVATE_KEY="$(cat SubscriptionKey_XXX.p8)"
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=app.meridian.planner

# Google — a service account JSON with the androidpublisher scope, as a single line:
#   supabase secrets set GOOGLE_SERVICE_ACCOUNT_JSON="$(cat service-account.json | tr -d '\n')"
GOOGLE_SERVICE_ACCOUNT_JSON=
ANDROID_PACKAGE_NAME=app.meridian.planner

# Shared secret in the store-notifications webhook URL. Generate with:
#   openssl rand -hex 32
STORE_WEBHOOK_SECRET=

# Speech to text (optional — voice capture is disabled at runtime without it).
# Supported: "openai" (Whisper). Leave blank to turn the feature off honestly.
TRANSCRIBE_PROVIDER=
OPENAI_API_KEY=

# Injected automatically inside Supabase Edge Functions — only needed for local `supabase functions serve`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
