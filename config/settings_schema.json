  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "t:settings_schema.typography.font_heading",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_heading_weight",
        "label": "t:settings_schema.typography.font_heading_weight",
        "min": 200,
        "max": 700,
        "step": 100,
        "default": 400
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "t:settings_schema.typography.font_body",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_body_scale",
        "label": "t:settings_schema.typography.font_body_scale",
        "min": 90,
        "max": 115,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "select",
        "id": "font_accent",
        "label": "t:settings_schema.typography.font_accent",
        "info": "t:settings_schema.typography.font_accent_info",
        "options": [
          { "value": "serif", "label": "t:settings_schema.typography.font_accent_serif" },
          { "value": "heading", "label": "t:settings_schema.typography.font_accent_heading" }
        ],
        "default": "serif"
      },
      {
        "type": "range",
        "id": "heading_tracking",
        "label": "t:settings_schema.typography.heading_tracking",
        "min": -5,
        "max": 2,
        "step": 1,
        "unit": "%",
        "default": -2
      }
    ]
  },
  {
