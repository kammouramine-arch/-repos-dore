      { "type": "color", "id": "color_bg", "label": "t:settings.colors.bg.label", "default": "#FFFFFF" }
    ]
  },
  {
    "name": "t:settings.typography.name",
    "settings": [
      { "type": "checkbox", "id": "load_theme_fonts", "default": true, "label": "t:settings.typography.load_theme_fonts.label", "info": "t:settings.typography.load_theme_fonts.info" }
    ]
  },
  {
