{%- liquid
  assign fallback = section.settings.fallback_image
-%}

<section
  class="section{% if section.settings.flush_top %} section--flush-top{% endif %}"
  id="{{ section.id }}"
>
  <div class="wrap split{% if section.settings.media_position == 'right' %} split--reverse{% endif %}">
    <div class="split__media{% if section.settings.media_style == 'light' %} split__media--light{% endif %}" data-reveal="clip">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 900px) 45vw, 90vw', alt: section.settings.image.alt | escape
        }}
      {%- elsif fallback != blank -%}
        <img
          src="{{ fallback | asset_url }}"
          alt=""
          width="600"
          height="600"
          loading="lazy"
          {% if settings.animations_parallax %}data-parallax="0.03"{% endif %}
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    <div class="split__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-reveal="fade">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2" data-reveal>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="lead" data-reveal style="--delay: 60ms">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="split__list">
          {%- for block in section.blocks -%}
            <li data-reveal style="--delay: {{ forloop.index | times: 60 | plus: 40 }}ms" {{ block.shopify_attributes }}>
              <span class="num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div>
                <strong>{{ block.settings.title }}</strong>
                <p>{{ block.settings.text }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="btn-row" data-reveal style="margin-top: 2.5rem; --delay: 260ms">
          <a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image et texte",
  "tag": "div",
  "class": "split-section",
  "max_blocks": 5,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Illustration de secours",
      "options": [
        { "value": "", "label": "Aucune" },
        { "value": "device-legs.svg", "label": "Bottes de compression" },
        { "value": "device-foot.svg", "label": "Masseur de pieds" },
        { "value": "device-neck.svg", "label": "Masseur de nuque" },
        { "value": "device-eye.svg", "label": "Masseur oculaire" },
        { "value": "device-unit.svg", "label": "Unité de contrôle" },
        { "value": "device-fabric.svg", "label": "Textile" },
        { "value": "device-case.svg", "label": "Housse de transport" }
      ],
      "default": "device-legs.svg"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Position du visuel",
      "options": [
        { "value": "left", "label": "À gauche" },
        { "value": "right", "label": "À droite" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_style",
      "label": "Fond du visuel",
      "options": [
        { "value": "dark", "label": "Sombre" },
        { "value": "light", "label": "Clair" }
      ],
      "default": "dark"
    },
    { "type": "checkbox", "id": "flush_top", "label": "Supprimer la marge haute", "default": false },
    { "type": "header", "content": "Contenu" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Technologie" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une pression pensée comme un geste, pas comme une machine." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Le mouvement remonte de la cheville vers la cuisse, exactement comme le drainage manuel pratiqué en cabinet.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point clé",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Compression séquentielle" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "De 20 à 120 mmHg, ajustable par palier de 5." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image et texte",
      "blocks": [
        { "type": "point", "settings": { "title": "Compression séquentielle 4 chambres", "text": "De 20 à 120 mmHg, ajustable par palier de 5." } },
        { "type": "point", "settings": { "title": "Moteur 38 dB", "text": "Plus discret qu’une conversation à voix basse." } },
        { "type": "point", "settings": { "title": "Six protocoles guidés", "text": "Un bouton, une intention." } }
      ]
    }
  ]
}
{% endschema %}
