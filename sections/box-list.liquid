<section class="section{% if section.settings.flush_top %} section--flush-top{% endif %}"{% if section.settings.background == 'grey' %} style="background:var(--grey-50)"{% endif %}>
  <div class="wrap wrap--narrow">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="section-head">
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal="fade">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="h2" data-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <ul class="box-list" data-reveal>
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>{{ block.settings.title }} <span>{{ block.settings.detail }}</span></li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.box_list.name",
  "class": "box-list-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "Dans la boîte" },
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "Tout est fourni. Rien n'est en option." },
    {
      "type": "select",
      "id": "background",
      "label": "t:common.background",
      "default": "grey",
      "options": [
        { "value": "white", "label": "t:common.background_white" },
        { "value": "grey", "label": "t:common.background_grey" }
      ]
    },
    { "type": "checkbox", "id": "flush_top", "default": false, "label": "t:common.flush_top" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.box_list.blocks.item.name",
      "settings": [
        { "type": "text", "id": "title", "label": "t:common.title", "default": "Deux bottes de compression" },
        { "type": "text", "id": "detail", "label": "t:sections.box_list.blocks.item.settings.detail.label", "default": "Taille au choix" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.box_list.name",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
