<section class="password">
  <div class="wrap password__inner">
    <p class="eyebrow" style="justify-content: center">{{ shop.name }}</p>
    <h1 class="display">
      {%- if section.settings.heading != blank -%}
        {{ section.settings.heading }}
      {%- else -%}
        {{ 'templates.password.title' | t }}
      {%- endif -%}
    </h1>

    {%- if section.settings.text != blank -%}
      <div class="lead rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {% form 'storefront_password', class: 'password__form' %}
      <label class="visually-hidden" for="PasswordInput">{{ 'templates.password.password' | t }}</label>
      <input
        class="input"
        id="PasswordInput"
        type="password"
        name="password"
        placeholder="{{ 'templates.password.password' | t }}"
        autocomplete="current-password"
      >
      <button class="btn btn--gold" type="submit">{{ 'templates.password.login' | t }}</button>

      {%- if form.errors -%}
        <p class="form__note form__note--error" role="alert">{{ form.errors.messages.form }}</p>
      {%- endif -%}
    {% endform %}

    <p class="muted">{{ 'templates.password.share' | t }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Page protégée",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Bientôt disponible" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Nous mettons la dernière main à la boutique.</p>" }
  ]
}
{% endschema %}
