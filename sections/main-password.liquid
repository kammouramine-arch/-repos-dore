<section class="page-hero page-hero--dark grain" style="min-height:100svh;display:grid;place-items:center">
  <div class="wrap center">
    <div class="page-hero__inner" style="margin-inline:auto">
      <p class="eyebrow eyebrow--gold" style="justify-content:center">{{ section.settings.eyebrow }}</p>
      <h1 class="display" style="margin-block:1.5rem">{{ shop.name }}</h1>
      <p class="lead">{{ section.settings.text }}</p>

      {%- form 'storefront_password', class: 'inline-form', novalidate: 'novalidate' -%}
        <input class="input" type="password" name="password" placeholder="{{ 'password.placeholder' | t }}" aria-label="{{ 'password.placeholder' | t }}" required>
        <button class="btn btn--gold btn--sm" type="submit">{{ 'password.enter' | t }}</button>
        {%- if form.errors -%}
          <span class="field__error is-visible" style="flex-basis:100%">{{ form.errors.messages.form }}</span>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "Bientôt" },
    { "type": "textarea", "id": "text", "label": "t:common.text", "default": "Notre boutique ouvre très bientôt." }
  ]
}
{% endschema %}
