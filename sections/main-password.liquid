{%- comment -%}
  Password page content — shown while the store is password protected.
{%- endcomment -%}

<section class="section" style="min-height:70vh; display:grid; place-items:center">
  <div class="wrap wrap--narrow">
    <div class="newsletter">
      <span class="footer__logo">{{ shop.name }}</span>

      {%- if section.settings.heading != blank -%}
        <h1 class="h2" style="margin-top:1rem">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rte lede">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="newsletter__form">
          {%- form 'customer', id: 'password-newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="form-success">{{ 'newsletter.success' | t }}</p>
            {%- else -%}
              <label class="visually-hidden" for="password-email">{{ 'newsletter.email' | t }}</label>
              <div class="field-inline">
                <input class="input" id="password-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required>
                <button type="submit">{{ 'newsletter.submit' | t }}</button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      <div style="margin-top:var(--sp-4); width:min(360px,100%)">
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}
            <p class="form-error" style="margin-bottom:1rem">{{ form.errors.messages.form }}</p>
          {%- endif -%}
          <label class="visually-hidden" for="store-password">{{ 'password.password' | t }}</label>
          <div class="field-inline">
            <input class="input" id="store-password" type="password" name="password" placeholder="{{ 'password.password' | t }}" required>
            <button type="submit">{{ 'password.enter' | t }}</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "Bientôt disponible" },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:common.text",
      "default": "<p>Nous mettons la dernière main à la boutique. Laissez-nous votre e-mail pour être prévenu·e de l'ouverture.</p>"
    },
    { "type": "checkbox", "id": "show_newsletter", "label": "t:sections.footer.show_newsletter", "default": true }
  ]
}
{% endschema %}
