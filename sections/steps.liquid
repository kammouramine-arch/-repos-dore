<section class="section{% if section.settings.flush_top %} section--flush-top{% endif %}">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="section-head">
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal="fade">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="h2" data-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="steps">
      {%- for block in section.blocks -%}
        <article class="step" data-reveal{% if forloop.index0 > 0 %} style="--delay:{{ forloop.index0 | times: 100 }}ms"{% endif %} {{ block.shopify_attributes }}>
          <div class="step__media">
            {%- if block.settings.image != blank -%}
              {%- assign img = block.settings.image -%}
              <img
                src="{{ img | image_url: width: 700 }}"
                srcset="{{ img | image_url: width: 350 }} 350w, {{ img | image_url: width: 550 }} 550w, {{ img | image_url: width: 700 }} 700w"
                sizes="(min-width: 900px) 30vw, 92vw"
                width="600" height="600"
                alt="{{ img.alt | escape }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          {%- if block.settings.step_label != blank -%}
            <span class="step__num">{{ block.settings.step_label }} {{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endif -%}
          <h3 class="h3">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.steps.name",
  "class": "steps-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "En trois gestes" },
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "Une séance ne demande aucune expertise." },
    { "type": "checkbox", "id": "flush_top", "default": false, "label": "t:common.flush_top" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.steps.blocks.step.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:common.image" },
        { "type": "text", "id": "step_label", "label": "t:sections.steps.blocks.step.settings.step_label.label", "default": "Étape" },
        { "type": "text", "id": "title", "label": "t:common.title", "default": "Enfiler" },
        { "type": "textarea", "id": "text", "label": "t:common.text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.steps.name",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
