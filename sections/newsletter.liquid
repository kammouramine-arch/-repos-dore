{%- comment -%}
  Newsletter
  Uses Shopify's native customer form, so subscribers land in Customers with
  the `newsletter` tag — no third-party app required.
{%- endcomment -%}

<section class="section scheme-{{ section.settings.color_scheme }}">
  <div class="wrap wrap--narrow">
    <div class="newsletter" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow eyebrow--gold">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="h2" style="max-width:18em">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <div class="newsletter__form">
        {%- form 'customer', id: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="form-success">{{ 'newsletter.success' | t }}</p>
          {%- else -%}
            <label class="visually-hidden" for="newsletter-email">{{ 'newsletter.email' | t }}</label>
            <div class="field-inline">
              <input
                class="input"
                id="newsletter-email"
                type="email"
                name="contact[email]"
                placeholder="{{ 'newsletter.email' | t }}"
                autocomplete="email"
                required
              >
              <button type="submit">{{ 'newsletter.submit' | t }}</button>
            </div>

            {%- if form.errors -%}
              <p class="form-error" style="margin-top:1rem; text-align:left">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="form-note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "newsletter-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "Lettre RÉVA" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "Une lettre par mois, sur le repos et rien d'autre"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:common.text",
      "default": "Protocoles, coulisses de fabrication, avant-premières. Aucune promotion agressive."
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:sections.newsletter.note",
      "default": "Désinscription en un clic. Vos données restent chez nous."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "light", "label": "t:common.scheme_light" },
        { "value": "sand", "label": "t:common.scheme_sand" },
        { "value": "stone", "label": "t:common.scheme_stone" },
        { "value": "dark", "label": "t:common.scheme_dark" }
      ],
      "default": "dark"
    }
  ],
  "presets": [{ "name": "t:sections.newsletter.name" }]
}
{% endschema %}
