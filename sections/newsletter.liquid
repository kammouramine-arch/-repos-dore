<section
  class="section newsletter{% if section.settings.flush_top %} section--flush-top{% endif %}"
  style="--newsletter-bg: {{ section.settings.background }}; --newsletter-fg: {{ section.settings.text_color }};"
>
  <div class="wrap wrap--narrow center">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow" data-reveal="fade" style="justify-content: center">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="h2" data-reveal style="margin-top: 1.25rem">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="lead" data-reveal style="--delay: 60ms; margin-top: 1.25rem">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="newsletter__form" data-reveal style="--delay: 120ms">
      {% form 'customer', class: 'inline-form inline-form--center', novalidate: 'novalidate' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">
          {{ 'general.newsletter.label' | t }}
        </label>
        <input
          class="input"
          id="NewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ 'general.newsletter.placeholder' | t }}"
          autocorrect="off"
          autocapitalize="off"
          required
        >
        <button class="btn btn--gold" type="submit">{{ 'general.newsletter.submit' | t }}</button>

        {%- if form.posted_successfully? -%}
          <p class="form__note form__note--success" role="status">{{ 'sections.newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form__note form__note--error" role="alert">{{ form.errors.messages.email }}</p>
        {%- endif -%}
      {% endform %}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="newsletter__note" data-reveal style="--delay: 160ms">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lettre d’information",
  "tag": "div",
  "class": "newsletter-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Rester informé" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Protocoles, lancements, coulisses." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Une lettre par mois, écrite par notre équipe. Rien d’autre.</p>"
    },
    { "type": "text", "id": "note", "label": "Mention", "default": "Désinscription en un clic · Aucune donnée revendue" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#0A0A0B" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "flush_top", "label": "Supprimer la marge haute", "default": false }
  ],
  "presets": [{ "name": "Lettre d’information" }]
}
{% endschema %}
