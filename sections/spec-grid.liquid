{%- comment -%}
  Bandeau de spécifications techniques.
  La donnée chiffrée porte l'argument : on la compose grande, l'unité en second.
{%- endcomment -%}

<section class="section{% if section.settings.flush_top %} section--flush-top{% endif %}">
  <div class="wrap">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-head{% if section.settings.center_heading %} section-head--center{% endif %}">
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow" data-reveal="fade">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="h2" data-reveal>{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <dl class="specs" data-reveal>
      {%- for block in section.blocks -%}
        <div class="spec" {{ block.shopify_attributes }}>
          <dt>{{ block.settings.label }}</dt>
          <dd>
            {{ block.settings.value }}
            {%- if block.settings.detail != blank -%}
              <small>{{ block.settings.detail }}</small>
            {%- endif -%}
          </dd>
        </div>
      {%- endfor -%}
    </dl>
  </div>
</section>

{% schema %}
{
  "name": "Spécifications",
  "tag": "div",
  "class": "specs-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Caractéristiques" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les chiffres qui comptent." },
    { "type": "checkbox", "id": "center_heading", "label": "Centrer le titre", "default": false },
    { "type": "checkbox", "id": "flush_top", "label": "Supprimer la marge haute", "default": false }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Caractéristique",
      "settings": [
        { "type": "text", "id": "label", "label": "Intitulé", "default": "Pression" },
        { "type": "text", "id": "value", "label": "Valeur", "default": "20 – 120" },
        { "type": "text", "id": "detail", "label": "Précision", "default": "mmHg, par paliers de 5" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Spécifications",
      "blocks": [
        { "type": "spec", "settings": { "label": "Pression", "value": "20 – 120", "detail": "mmHg, par paliers de 5" } },
        { "type": "spec", "settings": { "label": "Chambres", "value": "4", "detail": "par jambe, séquentielles" } },
        { "type": "spec", "settings": { "label": "Niveau sonore", "value": "38 dB", "detail": "mesuré à 1 mètre" } },
        { "type": "spec", "settings": { "label": "Autonomie", "value": "3 h", "detail": "sans fil, charge USB-C en 90 min" } }
      ]
    }
  ]
}
{% endschema %}
