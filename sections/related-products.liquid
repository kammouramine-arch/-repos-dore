{%- liquid
  assign related = collections[section.settings.collection]
  if related == blank or related.products.size == 0
    assign related = product.collections.first
  endif
  assign limit = section.settings.products_to_show
-%}

{%- if related.products.size > 0 -%}
  <section class="section{% if section.settings.flush_top %} section--flush-top{% endif %}">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal="fade">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="h2" data-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
        </div>
        {%- if section.settings.link_label != blank -%}
          <a class="text-link" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}" data-reveal>
            {{ section.settings.link_label }}
            {%- render 'icon', name: 'arrow-right' -%}
          </a>
        {%- endif -%}
      </div>

      <div class="cards">
        {%- assign shown = 0 -%}
        {%- for related_product in related.products -%}
          {%- if related_product.id != product.id and shown < limit -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- render 'card-product', product: related_product, index: forloop.index0, cta: section.settings.card_cta -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.related_products.name",
  "class": "related-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "Compléter le rituel" },
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "Souvent associés" },
    { "type": "collection", "id": "collection", "label": "t:sections.related_products.settings.collection.label", "info": "t:sections.related_products.settings.collection.info" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "t:sections.featured_collection.settings.products_to_show.label", "default": 2 },
    { "type": "text", "id": "link_label", "label": "t:sections.featured_collection.settings.link_label.label", "default": "Toute la collection" },
    { "type": "url", "id": "link_url", "label": "t:sections.featured_collection.settings.link_url.label" },
    { "type": "text", "id": "card_cta", "label": "t:sections.featured_collection.settings.card_cta.label", "default": "Découvrir" },
    { "type": "checkbox", "id": "flush_top", "default": true, "label": "t:common.flush_top" }
  ],
  "presets": [{ "name": "t:sections.related_products.name" }]
}
{% endschema %}
