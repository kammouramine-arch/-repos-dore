<section class="page-hero">
  <div class="wrap">
    <div class="page-hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-reveal="fade">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="h1" data-reveal="fade">{{ blog.title }}</h1>
    </div>
  </div>
</section>

<section class="section" style="padding-top:clamp(1rem,3vw,2rem)">
  <div class="wrap">
    {%- paginate blog.articles by 12 -%}
      <div class="cards">
        {%- for article in blog.articles -%}
          <article class="card" data-reveal="scale" style="--delay:{{ forloop.index0 | times: 60 }}ms">
            <a class="card__link" href="{{ article.url }}"><span>{{ article.title }}</span></a>
            <div class="card__media">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | escape }}" width="600" height="600" loading="lazy">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </div>
            <div class="card__body">
              <div>
                <h2 class="card__title">{{ article.title }}</h2>
                <p class="card__desc">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
              </div>
            </div>
            <div class="card__cta">
              <span class="card__stars">{{ article.published_at | date: format: 'on_date' }}</span>
              <span class="btn btn--sm btn--ghost">{{ 'blog.read' | t }}</span>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}
            <a class="pagination__link" href="{{ paginate.previous.url }}">{%- render 'icon', name: 'chevron-left' -%}</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a class="pagination__link" href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span class="pagination__link is-current" aria-current="page">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a class="pagination__link" href="{{ paginate.next.url }}">{%- render 'icon', name: 'chevron-right' -%}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "Journal" }
  ]
}
{% endschema %}
