<section class="section{% if section.settings.flush_top %} section--flush-top{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %}{% if section.settings.background == 'grey' %} style="background:var(--grey-50)"{% endif %}>
  <div class="wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="section-head">
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal="fade">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="h2" data-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="values">
      {%- for block in section.blocks -%}
        <article class="value" data-reveal{% if forloop.index0 > 0 %} style="--delay:{{ forloop.index0 | times: 100 }}ms"{% endif %} {{ block.shopify_attributes }}>
          {%- render 'icon', name: block.settings.icon -%}
          <h3 class="h3">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.values.name",
  "class": "values-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "Engagements" },
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "Trois promesses que nous tenons par écrit." },
    {
      "type": "select",
      "id": "background",
      "label": "t:common.background",
      "default": "grey",
      "options": [
        { "value": "white", "label": "t:common.background_white" },
        { "value": "grey", "label": "t:common.background_grey" }
      ]
    },
    { "type": "text", "id": "anchor", "label": "t:common.anchor", "info": "t:common.anchor_info", "default": "valeurs" },
    { "type": "checkbox", "id": "flush_top", "default": false, "label": "t:common.flush_top" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "t:sections.values.blocks.value.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:common.icon",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "t:icons.shield" },
            { "value": "clock", "label": "t:icons.clock" },
            { "value": "account", "label": "t:icons.account" },
            { "value": "truck", "label": "t:icons.truck" },
            { "value": "card", "label": "t:icons.card" },
            { "value": "check", "label": "t:icons.check" },
            { "value": "pin", "label": "t:icons.pin" },
            { "value": "star", "label": "t:icons.star" }
          ]
        },
        { "type": "text", "id": "title", "label": "t:common.title", "default": "Réparer plutôt que remplacer" },
        { "type": "textarea", "id": "text", "label": "t:common.text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.values.name",
      "blocks": [{ "type": "value" }, { "type": "value" }, { "type": "value" }]
    }
  ]
}
{% endschema %}
