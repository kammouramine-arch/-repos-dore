<section class="page-hero">
  <div class="wrap">
    <div class="page-hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-reveal="fade">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="h1" data-reveal="fade">{{ collection.title }}</h1>
      {%- if collection.description != blank and section.settings.show_description -%}
        <div class="lead" data-reveal style="--delay:100ms">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

<section class="section" style="padding-top:clamp(1rem,3vw,2rem)">
  <div class="wrap">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="cards">
          {%- for product in collection.products -%}
            {%- render 'card-product', product: product, index: forloop.index0, cta: section.settings.card_cta -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
            {%- if paginate.previous -%}
              <a class="pagination__link" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">{%- render 'icon', name: 'chevron-left' -%}</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a class="pagination__link" href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span class="pagination__link is-current" aria-current="page">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a class="pagination__link" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">{%- render 'icon', name: 'chevron-right' -%}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="muted">{{ 'collections.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "class": "collection-page-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "Collection" },
    { "type": "checkbox", "id": "show_description", "default": true, "label": "t:sections.main_collection.settings.show_description.label" },
    { "type": "range", "id": "products_per_page", "min": 4, "max": 24, "step": 4, "label": "t:sections.main_collection.settings.products_per_page.label", "default": 12 },
    { "type": "text", "id": "card_cta", "label": "t:sections.featured_collection.settings.card_cta.label", "default": "Découvrir" }
  ]
}
{% endschema %}
