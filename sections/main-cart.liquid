<section class="section">
  <div class="wrap wrap--narrow">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">{{ 'cart.title' | t }}</p>
        <h1 class="h2">{{ section.settings.heading | default: 'Votre panier' }}</h1>
      </div>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        {%- render 'icon', name: 'cart' -%}
        <p>{{ 'cart.empty.title' | t }}<br><span class="muted">{{ 'cart.empty.text' | t }}</span></p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty.link' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-form">
        <div class="cart-lines">
          {%- for item in cart.items -%}
            <div class="drawer-line">
              <div class="drawer-line__media">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="100" height="100" loading="lazy">
                {%- endif -%}
              </div>
              <div style="display:flex;flex-direction:column;flex:1;min-width:0">
                <p class="drawer-line__name"><a href="{{ item.url }}">{{ item.product.title }}</a></p>
                <p class="drawer-line__meta">
                  {%- unless item.product.has_only_default_variant -%}{{ item.variant.title }}{%- endunless -%}
                  {%- if item.selling_plan_allocation %} · {{ item.selling_plan_allocation.selling_plan.name }}{% endif -%}
                </p>
                <p class="drawer-line__price">{{ item.final_line_price | money }}</p>
              </div>
              <div class="cart-line__actions">
                <div class="qty" data-qty>
                  <button type="button" data-qty-step="-1" aria-label="{{ 'products.product.quantity_down' | t }}">−</button>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" max="99" aria-label="{{ 'products.product.quantity' | t }}">
                  <button type="button" data-qty-step="1" aria-label="{{ 'products.product.quantity_up' | t }}">+</button>
                </div>
                <a class="cart-line__remove" href="{{ item.url_to_remove }}">{{ 'cart.line.remove' | t }}</a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.show_note -%}
          <label class="field" style="margin-top:2rem">
            <span class="field__label">{{ 'cart.note' | t }}</span>
            <textarea class="textarea" name="note" style="min-height:6rem">{{ cart.note }}</textarea>
          </label>
        {%- endif -%}

        <div class="cart-foot">
          <div class="cart-foot__total">
            <span class="muted">{{ 'cart.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="muted" style="font-size:var(--fs-xs)">{{ 'cart.taxes_note' | t }}</p>
          <div class="btn-row" style="margin-top:1.5rem">
            <button class="btn" type="submit" name="update">{{ 'cart.update' | t }}</button>
            <button class="btn btn--gold" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "class": "cart-page-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "Votre panier" },
    { "type": "checkbox", "id": "show_note", "default": true, "label": "t:sections.main_cart.settings.show_note.label" }
  ]
}
{% endschema %}
