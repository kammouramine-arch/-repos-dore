<section class="page-hero">
  <div class="wrap">
    <div class="page-hero__inner">
      <p class="eyebrow" data-reveal="fade">{{ shop.name }}</p>
      <h1 class="h1" data-reveal="fade">{{ 'templates.cart.title' | t }}</h1>
    </div>
  </div>
</section>

<section class="section" style="padding-top: 0">
  <div class="wrap">
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        {% render 'icon', icon: 'cart' %}
        <p class="lead">{{ 'cart.general.empty' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-form">
        <div class="cart-layout">
          <div>
            <ul class="cart-lines">
              {%- for item in cart.items -%}
                <li class="cart-line" data-cart-item="{{ item.key }}">
                  <a class="cart-line__media" href="{{ item.url }}">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.title | escape }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {%- endif -%}
                  </a>

                  <div class="cart-line__info">
                    <a class="cart-line__name" href="{{ item.url }}">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="cart-line__meta">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    <p class="cart-line__meta">{{ item.original_price | money }}</p>
                    {% render 'quantity-input', id: 'CartPageQty-', value: item.quantity, min: 0, line: forloop.index %}
                  </div>

                  <div class="cart-line__end">
                    <span class="cart-line__price">{{ item.final_line_price | money }}</span>
                    <button
                      class="cart-line__remove"
                      type="button"
                      data-cart-remove="{{ forloop.index }}"
                      aria-label="{{ 'cart.general.remove' | t: title: item.title }}"
                    >
                      {% render 'icon', icon: 'close' %}
                    </button>
                  </div>
                </li>
              {%- endfor -%}
            </ul>

            {%- if settings.cart_show_note -%}
              <div class="cart-note">
                <label class="field__label" for="CartPageNote">{{ 'cart.general.note' | t }}</label>
                <textarea
                  class="textarea"
                  id="CartPageNote"
                  name="note"
                  data-cart-note
                  placeholder="{{ 'cart.general.note_placeholder' | t }}"
                >{{ cart.note }}</textarea>
              </div>
            {%- endif -%}
          </div>

          <aside class="cart-summary">
            <h2 class="h4">{{ 'cart.general.subtotal' | t }}</h2>
            <p class="cart-summary__total" data-cart-total>{{ cart.total_price | money }}</p>

            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="cart-summary__discounts">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li>{{ discount.title }} <span>−{{ discount.total_allocated_amount | money }}</span></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <p class="muted">{{ 'cart.general.taxes_note' | t }}</p>
            <button class="btn btn--block" type="submit" name="checkout">{{ 'cart.general.checkout' | t }}</button>
            <a class="text-link" href="{{ routes.all_products_collection_url }}">
              {{ 'general.continue_shopping' | t }}
              {% render 'icon', icon: 'arrow-right' %}
            </a>
          </aside>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Panier",
  "tag": "div",
  "settings": []
}
{% endschema %}
