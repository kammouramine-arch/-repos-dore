<article class="article">
  <section class="page-hero">
    <div class="wrap">
      <div class="page-hero__inner">
        <p class="eyebrow" data-reveal="fade">
          {{ article.published_at | date: '%d.%m.%Y' }}
          {%- if article.author != blank %} · {{ 'blogs.article.author' | t: author: article.author }}{% endif -%}
        </p>
        <h1 class="h1" data-reveal="fade">{{ article.title }}</h1>
      </div>
    </div>
  </section>

  {%- if article.image -%}
    <div class="wrap">
      <div class="article__cover" data-reveal="clip">
        {%- assign article_alt = article.title | escape -%}
        {{
          article.image
          | image_url: width: 2000
          | image_tag: loading: 'eager', widths: '600, 1000, 1500, 2000', sizes: '90vw', alt: article_alt
        }}
      </div>
    </div>
  {%- endif -%}

  <section class="section" style="padding-top: clamp(2rem, 4vw, 3rem)">
    <div class="wrap">
      <div class="prose rte" data-reveal>{{ article.content }}</div>

      {%- if article.tags.size > 0 -%}
        <p class="article__tags">
          <span class="eyebrow eyebrow--plain">{{ 'blogs.article.tags' | t }}</span>
          {%- for tag in article.tags -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
          {%- endfor -%}
        </p>
      {%- endif -%}

      <p style="margin-top: 3rem">
        <a class="text-link" href="{{ blog.url }}">
          {{ 'blogs.article.back_to_blog' | t }}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      </p>

      {%- if blog.comments_enabled? -%}
        <div class="article__comments">
          <h2 class="h3">{{ 'blogs.comments.title' | t }}</h2>

          {%- if article.comments_count > 0 -%}
            <ul class="comments">
              {%- for comment in article.comments -%}
                <li class="comment">
                  <p>{{ comment.content }}</p>
                  <p class="comment__meta">{{ comment.author }} · {{ comment.created_at | date: '%d.%m.%Y' }}</p>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {% form 'new_comment', article, class: 'form-card' %}
            {%- if form.posted_successfully? -%}
              <p class="form__note form__note--success" role="status">{{ 'blogs.comments.success' | t }}</p>
            {%- endif -%}

            <div class="form-grid">
              <label class="field">
                <span class="field__label">{{ 'blogs.comments.name' | t }}</span>
                <input class="input" type="text" name="comment[author]" value="{{ form.author }}" required>
              </label>
              <label class="field">
                <span class="field__label">{{ 'blogs.comments.email' | t }}</span>
                <input class="input" type="email" name="comment[email]" value="{{ form.email }}" required>
              </label>
              <label class="field field--full">
                <span class="field__label">{{ 'blogs.comments.message' | t }}</span>
                <textarea class="textarea" name="comment[body]" required>{{ form.body }}</textarea>
              </label>
            </div>

            <button class="btn" type="submit" style="margin-top: 1.5rem">{{ 'blogs.comments.submit' | t }}</button>
            {%- if blog.moderated? -%}
              <p class="muted" style="margin-top: 1rem; font-size: var(--fs-xs)">{{ 'blogs.comments.moderated' | t }}</p>
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}
    </div>
  </section>
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Article",
  "tag": "div",
  "settings": []
}
{% endschema %}
