{%- assign parallax_speed = section.settings.parallax | divided_by: 100.0 -%}
<section class="bleed grain"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %}>
  <div class="bleed__bg" data-parallax="{{ parallax_speed }}"{% if section.settings.image != blank %} style="background-image:linear-gradient(180deg,rgba(14,29,51,.78),rgba(8,17,30,.9)),url({{ section.settings.image | image_url: width: 1800 }});background-size:cover;background-position:center"{% endif %}></div>
  <div class="wrap bleed__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow" data-reveal="fade" style="justify-content:center">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="h1" data-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p data-reveal style="--delay:80ms">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
      <div class="btn-row" data-reveal style="--delay:140ms">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--light" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="btn btn--outline-light" href="{{ section.settings.button_2_link | default: '#' }}">{{ section.settings.button_2_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.bleed.name",
  "class": "bleed-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "Conçu pour durer" },
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "Aluminium anodisé, tissu technique, zéro plastique apparent." },
    { "type": "textarea", "id": "text", "label": "t:common.text" },
    { "type": "image_picker", "id": "image", "label": "t:sections.bleed.settings.image.label", "info": "t:sections.bleed.settings.image.info" },
    { "type": "range", "id": "parallax", "min": 0, "max": 15, "step": 1, "unit": "%", "label": "t:common.parallax", "default": 8 },
    { "type": "header", "content": "t:common.buttons" },
    { "type": "text", "id": "button_label", "label": "t:common.button_label" },
    { "type": "url", "id": "button_link", "label": "t:common.button_link" },
    { "type": "text", "id": "button_2_label", "label": "t:common.button_2_label" },
    { "type": "url", "id": "button_2_link", "label": "t:common.button_2_link" },
    { "type": "header", "content": "t:common.layout" },
    { "type": "text", "id": "anchor", "label": "t:common.anchor", "info": "t:common.anchor_info" }
  ],
  "presets": [{ "name": "t:sections.bleed.name" }]
}
{% endschema %}
