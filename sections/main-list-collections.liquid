<section class="page-hero">
  <div class="wrap">
    <div class="page-hero__inner">
      <p class="eyebrow" data-reveal="fade">{{ shop.name }}</p>
      <h1 class="h1" data-reveal="fade">{{ 'templates.collections.title' | t }}</h1>
    </div>
  </div>
</section>

<section class="section" style="padding-top: 0">
  <div class="wrap">
    {%- if collections.size == 0 -%}
      {%- comment -%} Aucune collection : on renvoie vers le catalogue plutôt qu'une page nue. {%- endcomment -%}
      <div class="collection-empty">
        <p class="lead">{{ 'templates.collections.empty' | t }}</p>
        <div class="btn-row" style="justify-content: center; margin-top: 2rem">
          {% render 'button', label: 'general.continue_shopping' | t, link: routes.all_products_collection_url, size: 'lg' %}
        </div>
      </div>
    {%- else -%}
    <div class="cards cards--3">
      {%- for collection in collections -%}
        <article class="card" data-reveal="scale" style="--delay: {{ forloop.index0 | times: 60 }}ms">
          <a class="card__link" href="{{ collection.url }}">
            <span class="visually-hidden">{{ collection.title }}</span>
          </a>
          <div class="card__media card__media--landscape">
            {%- if collection.featured_image -%}
              {%- assign collection_alt = collection.title | escape -%}
              {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', alt: collection_alt }}
            {%- else -%}
              {%- liquid
                assign fallbacks = 'device-legs.svg,device-foot.svg,device-neck.svg,device-eye.svg' | split: ','
                assign pick = forloop.index0 | modulo: 4
              -%}
              <img class="card__img card__img--illustration" src="{{ fallbacks[pick] | asset_url }}"
                   alt="{{ collection_alt }}" width="600" height="600" loading="lazy">
            {%- endif -%}
          </div>
          <div class="card__body">
            <div>
              <h2 class="card__title">{{ collection.title }}</h2>
              <p class="card__desc">{{ 'products.facets.results_count' | t: count: collection.products_count }}</p>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Liste des collections",
  "tag": "div",
  "settings": []
}
{% endschema %}
