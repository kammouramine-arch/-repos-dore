{%- liquid
  assign limit = section.settings.products_to_show
-%}

<product-recommendations
  class="section section--flush-top"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow" data-reveal="fade">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="h2" data-reveal>{{ section.settings.heading }}</h2>
        </div>
        <a class="text-link" href="{{ routes.all_products_collection_url }}" data-reveal>
          {{ section.settings.link_label }}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      </div>

      <div class="cards cards--{{ section.settings.columns }}">
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Recommandations",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Compléter le rituel" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Souvent associés" },
    { "type": "text", "id": "link_label", "label": "Lien", "default": "Toute la collection" },
    { "type": "range", "id": "products_to_show", "label": "Nombre de produits", "min": 2, "max": 8, "step": 1, "default": 2 },
    {
      "type": "select",
      "id": "columns",
      "label": "Colonnes",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "2"
    }
  ]
}
{% endschema %}
