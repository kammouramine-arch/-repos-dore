{%- comment -%}
  Testimonials
  One quote at a time, set large. Arrows, dots, swipe and optional autoplay —
  all paused for visitors who ask for reduced motion.
{%- endcomment -%}

<section class="section scheme-{{ section.settings.color_scheme }}">
  <div class="wrap wrap--narrow">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="section-head section-head--center">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow eyebrow--gold" data-reveal="fade">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2" data-reveal>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="quotes" data-quotes data-quotes-autoplay="{{ section.settings.autoplay }}" data-reveal>
      <div class="quotes__viewport">
        <div class="quotes__track" data-quotes-track>
          {%- for block in section.blocks -%}
            <div class="quotes__slide" data-quotes-slide {{ block.shopify_attributes }}>
              <figure class="quote">
                {%- if block.settings.rating > 0 -%}
                  <div class="quote__stars" aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}">
                    {%- for i in (1..block.settings.rating) -%}
                      {%- render 'icon', name: 'star' -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <blockquote class="quote__text">{{ block.settings.quote | escape }}</blockquote>

                <figcaption class="quote__who">
                  {{ block.settings.author | escape }}
                  {%- if block.settings.detail != blank %} — {{ block.settings.detail | escape }}{% endif -%}
                </figcaption>
              </figure>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="quotes__nav">
          <button class="quotes__arrow" type="button" data-quotes-prev aria-label="{{ 'general.slider.previous' | t }}">
            {%- render 'icon', name: 'arrow-left' -%}
          </button>
          <div class="quotes__dots">
            {%- for block in section.blocks -%}
              <button
                class="quotes__dot{% if forloop.first %} is-active{% endif %}"
                type="button"
                data-quotes-dot
                aria-label="{{ 'general.slider.go_to' | t: index: forloop.index }}"
              ></button>
            {%- endfor -%}
          </div>
          <button class="quotes__arrow" type="button" data-quotes-next aria-label="{{ 'general.slider.next' | t }}">
            {%- render 'icon', name: 'arrow-right' -%}
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "class": "testimonials-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "Ils l'utilisent" },
    { "type": "text", "id": "heading", "label": "t:common.heading" },
    { "type": "checkbox", "id": "autoplay", "label": "t:common.autoplay", "default": true },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "light", "label": "t:common.scheme_light" },
        { "value": "sand", "label": "t:common.scheme_sand" },
        { "value": "stone", "label": "t:common.scheme_stone" },
        { "value": "dark", "label": "t:common.scheme_dark" }
      ],
      "default": "sand"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "t:sections.testimonials.block_quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.testimonials.quote",
          "default": "Je l'utilise chaque soir après l'entraînement. Mes jambes ne sont plus les mêmes le lendemain."
        },
        { "type": "text", "id": "author", "label": "t:sections.testimonials.author", "default": "Camille L." },
        { "type": "text", "id": "detail", "label": "t:sections.testimonials.detail", "default": "Marathonienne, Lyon" },
        {
          "type": "range",
          "id": "rating",
          "label": "t:sections.testimonials.rating_label",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }]
    }
  ]
}
{% endschema %}
