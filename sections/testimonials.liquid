<section class="section section--band" style="background: {{ section.settings.background }};">
  <div class="wrap">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="center" style="margin-bottom: clamp(2.5rem, 5vw, 4rem)">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow" data-reveal="fade" style="justify-content: center">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2" data-reveal style="margin-top: 1.25rem">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <quote-carousel class="quotes" data-quotes>
      <div class="quotes__viewport">
        <div class="quotes__track" data-quotes-track>
          {%- for block in section.blocks -%}
            <figure class="quote" {{ block.shopify_attributes }}>
              {%- if block.settings.rating > 0 -%}
                <div class="quote__stars" role="img" aria-label="{{ 'general.accessibility.star_reviews_info' | t: rating_value: block.settings.rating, rating_max: 5 }}">
                  {%- for i in (1..block.settings.rating) -%}
                    {% render 'icon', icon: 'star' %}
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <blockquote>{{ block.settings.quote }}</blockquote>

              <figcaption>
                <strong>{{ block.settings.author }}</strong>
                {{ block.settings.detail }}
              </figcaption>
            </figure>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="quotes__nav">
          <button class="arrow-btn" type="button" data-quotes-prev aria-label="{{ 'sections.quotes.previous' | t }}">
            {% render 'icon', icon: 'chevron-left' %}
          </button>
          <div class="quotes__dots" data-quotes-dots></div>
          <button class="arrow-btn" type="button" data-quotes-next aria-label="{{ 'sections.quotes.next' | t }}">
            {% render 'icon', icon: 'chevron-right' %}
          </button>
        </div>
      {%- endif -%}
    </quote-carousel>
  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "tag": "div",
  "class": "quotes-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Ils nous font confiance" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "4,9 sur 5 — 2 418 avis vérifiés" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#F8F8F9" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Témoignage",
      "settings": [
        { "type": "range", "id": "rating", "label": "Note", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Citation", "default": "« J’ai testé trois marques avant celle-ci. C’est la première fois qu’un appareil de compression ne ressemble pas à du matériel médical posé dans mon salon. »" },
        { "type": "text", "id": "author", "label": "Auteur", "default": "Claire M." },
        { "type": "text", "id": "detail", "label": "Précision", "default": "Marathonienne · Lyon · Achat vérifié" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis clients",
      "blocks": [
        { "type": "quote" },
        {
          "type": "quote",
          "settings": {
            "quote": "« Douze heures debout en bloc opératoire. Vingt minutes le soir et mes jambes repartent à zéro. »",
            "author": "Dr Antoine R.",
            "detail": "Chirurgien · Bordeaux · Achat vérifié"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "« Le service client m’a rappelée un dimanche pour ajuster mon protocole. Ce niveau d’attention, je ne l’avais connu que chez un horloger. »",
            "author": "Nadia B.",
            "detail": "Cheffe d’entreprise · Paris · Achat vérifié"
          }
        }
      ]
    }
  ]
}
{% endschema %}
