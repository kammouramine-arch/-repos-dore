<section class="section"{% if section.settings.background == 'grey' %} style="background:var(--grey-50)"{% endif %}>
  <div class="wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="center" style="margin-bottom:clamp(2.5rem,5vw,4rem)">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow" data-reveal="fade" style="justify-content:center">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2" data-reveal style="margin-top:1.25rem">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="quotes" data-quotes>
      <div class="quotes__viewport">
        <div class="quotes__track" data-quotes-track>
          {%- for block in section.blocks -%}
            {%- assign star_label = block.settings.rating | append: ' / 5' -%}
            <figure class="quote" {{ block.shopify_attributes }}>
              {%- render 'stars', rating: block.settings.rating, class: 'quote__stars', label: star_label -%}
              <blockquote>{{ block.settings.quote }}</blockquote>
              <figcaption><strong>{{ block.settings.author }}</strong>{{ block.settings.meta }}</figcaption>
            </figure>
          {%- endfor -%}
        </div>
      </div>

      <div class="quotes__nav">
        <button class="arrow-btn" type="button" data-quotes-prev aria-label="{{ 'testimonials.previous' | t }}">
          {%- render 'icon', name: 'chevron-left' -%}
        </button>
        <div class="quotes__dots" data-quotes-dots></div>
        <button class="arrow-btn" type="button" data-quotes-next aria-label="{{ 'testimonials.next' | t }}">
          {%- render 'icon', name: 'chevron-right' -%}
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "class": "testimonials-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "Ils nous font confiance" },
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "4,9 sur 5 — 2 418 avis vérifiés" },
    {
      "type": "select",
      "id": "background",
      "label": "t:common.background",
      "default": "grey",
      "options": [
        { "value": "white", "label": "t:common.background_white" },
        { "value": "grey", "label": "t:common.background_grey" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "t:sections.testimonials.blocks.quote.name",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "t:common.rating", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "t:common.quote", "default": "« Le meilleur achat de l'année. »" },
        { "type": "text", "id": "author", "label": "t:common.author", "default": "Claire M." },
        { "type": "text", "id": "meta", "label": "t:common.author_meta", "default": "Marathonienne · Lyon · Achat vérifié" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }]
    }
  ]
}
{% endschema %}
