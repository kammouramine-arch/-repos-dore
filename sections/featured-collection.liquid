{%- comment -%}
  Featured collection
  Pulls a real collection from the store. Falls back to the first available
  collection, then to onboarding placeholders, so the section is never empty.
{%- endcomment -%}

{%- liquid
  assign target = section.settings.collection
  if target == blank
    assign target = collections.all
  endif
  assign products = target.products
  assign limit = section.settings.products_to_show
-%}

<section class="section scheme-{{ section.settings.color_scheme }}">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow" data-reveal="fade">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2" data-reveal>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="lede" data-reveal style="--delay:100ms">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all and target != blank and target.url != blank -%}
        <a class="link" href="{{ target.url }}" data-reveal="fade">
          {{ 'sections.collection.view_all' | t }}
        </a>
      {%- endif -%}
    </div>

    {%- if products.size > 0 -%}
      <div class="grid grid--{{ section.settings.columns }} grid--2-mobile{% if section.settings.mobile_scroller %} scroller-mobile{% endif %}">
        {%- for product in products limit: limit -%}
          {%- render 'product-card', product: product, index: forloop.index0 -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%} Onboarding state — visible only while the store has no products. {%- endcomment -%}
      <div class="grid grid--{{ section.settings.columns }} grid--2-mobile">
        {%- for i in (1..section.settings.columns) -%}
          <article class="card">
            <div class="card__media media {{ settings.card_image_ratio }}">
              {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="card__body">
              <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
              <span class="card__price">{{ 1990 | money }}</span>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "class": "featured-collection-section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:sections.featured_collection.collection" },
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "La collection" },
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "Quatre appareils. Un seul geste." },
    { "type": "text", "id": "description", "label": "t:common.description" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collection.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:common.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    { "type": "checkbox", "id": "mobile_scroller", "label": "t:common.mobile_scroller", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "t:sections.featured_collection.view_all", "default": true },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "light", "label": "t:common.scheme_light" },
        { "value": "sand", "label": "t:common.scheme_sand" },
        { "value": "stone", "label": "t:common.scheme_stone" },
        { "value": "dark", "label": "t:common.scheme_dark" }
      ],
      "default": "light"
    }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
