{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
  assign dark_position = section.settings.dark_card_position
-%}

<section class="section{% if section.settings.flush_top %} section--flush-top{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %}>
  <div class="wrap">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal="fade">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h2" data-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="lead" data-reveal style="--delay:80ms">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="text-link" href="{{ section.settings.link_url | default: '#' }}" data-reveal>
          {{ section.settings.link_label }}
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      {%- endif -%}
    </div>

    <div class="cards">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {%- liquid
            assign is_dark = false
            if dark_position > 0 and forloop.index == dark_position
              assign is_dark = true
            endif
          -%}
          {%- render 'card-product',
            product: product,
            index: forloop.index0,
            dark: is_dark,
            cta: section.settings.card_cta
          -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <article class="card" data-reveal="scale" style="--delay:{{ forloop.index0 | times: 60 }}ms">
            <div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
            <div class="card__body">
              <div>
                <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
                <p class="card__desc">{{ 'onboarding.product_subtitle' | t }}</p>
              </div>
              <p class="card__price">{{ 19900 | money }}</p>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "class": "collection-section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:sections.featured_collection.settings.collection.label" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "t:sections.featured_collection.settings.products_to_show.label", "default": 4 },
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "La collection" },
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "Quatre appareils, quatre territoires du corps." },
    { "type": "textarea", "id": "text", "label": "t:common.text" },
    { "type": "text", "id": "link_label", "label": "t:sections.featured_collection.settings.link_label.label" },
    { "type": "url", "id": "link_url", "label": "t:sections.featured_collection.settings.link_url.label" },
    { "type": "text", "id": "card_cta", "label": "t:sections.featured_collection.settings.card_cta.label", "default": "Découvrir" },
    { "type": "header", "content": "t:common.layout" },
    { "type": "text", "id": "anchor", "label": "t:common.anchor", "info": "t:common.anchor_info", "default": "collection" },
    { "type": "checkbox", "id": "flush_top", "default": true, "label": "t:common.flush_top" },
    {
      "type": "range",
      "id": "dark_card_position",
      "min": 0,
      "max": 12,
      "step": 1,
      "label": "t:sections.featured_collection.settings.dark_card_position.label",
      "info": "t:sections.featured_collection.settings.dark_card_position.info",
      "default": 3
    }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
