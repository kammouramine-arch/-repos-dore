<section class="section{% if section.settings.flush_top %} section--flush-top{% endif %}">
  <div class="wrap">
    <div class="cta-band" data-reveal="scale">
      <div class="cta-band__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--gold">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2" style="margin-top: 1.25rem">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="cta-band__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--gold" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <p class="cta-band__note">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bloc d’appel à l’action",
  "tag": "div",
  "class": "cta-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Essai 30 nuits" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Testez chez vous. Décidez ensuite." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Si l’appareil ne change pas vos soirées, nous organisons le retour et vous remboursons intégralement.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir la collection" },
    { "type": "url", "id": "button_link", "label": "Lien" },
    { "type": "text", "id": "note", "label": "Mention sous le bouton", "default": "Livraison 48 h · Paiement en 3× sans frais · Garantie 2 ans" },
    { "type": "checkbox", "id": "flush_top", "label": "Supprimer la marge haute", "default": false }
  ],
  "presets": [{ "name": "Bloc d’appel à l’action" }]
}
{% endschema %}
