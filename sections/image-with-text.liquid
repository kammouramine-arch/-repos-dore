{%- liquid
  assign parallax_speed = section.settings.parallax | divided_by: 100.0
  assign has_prose = false
  assign has_list = false
  for block in section.blocks
    if block.type == 'paragraph' or block.type == 'quote'
      assign has_prose = true
    endif
    if block.type == 'item'
      assign has_list = true
    endif
  endfor
-%}

<section class="section{% if section.settings.flush_top %} section--flush-top{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %}>
  <div class="wrap split{% if section.settings.reverse %} split--reverse{% endif %}">
    <div class="split__media{% if section.settings.light_media %} split__media--light{% endif %}" data-reveal="clip">
      {%- if section.settings.image != blank -%}
        {%- assign img = section.settings.image -%}
        <img
          src="{{ img | image_url: width: 900 }}"
          srcset="{{ img | image_url: width: 450 }} 450w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 900px) 45vw, 92vw"
          width="{{ img.width }}"
          height="{{ img.height }}"
          alt="{{ img.alt | escape }}"
          loading="lazy"
          data-parallax="{{ parallax_speed }}"
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>

    <div class="split__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal="fade">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2" data-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="lead" data-reveal style="--delay:60ms">{{ section.settings.text }}</p>{%- endif -%}

      {%- if has_prose -%}
        <div class="prose" data-reveal style="--delay:60ms">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'paragraph' -%}
                <p {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
              {%- when 'quote' -%}
                <blockquote {{ block.shopify_attributes }}>{{ block.settings.text }}</blockquote>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if has_list -%}
        <ul class="split__list">
          {%- assign item_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'item' -%}
              {%- assign item_index = item_index | plus: 1 -%}
              <li data-reveal style="--delay:{{ item_index | times: 60 | plus: 40 }}ms" {{ block.shopify_attributes }}>
                <span class="num">{{ item_index | prepend: '0' | slice: -2, 2 }}</span>
                <div>
                  <strong>{{ block.settings.title }}</strong>
                  {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="btn-row" data-reveal style="margin-top:2.5rem;--delay:260ms">
          <a class="btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "class": "split-section",
  "max_blocks": 8,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:common.image" },
    { "type": "checkbox", "id": "reverse", "default": false, "label": "t:sections.image_with_text.settings.reverse.label" },
    { "type": "checkbox", "id": "light_media", "default": false, "label": "t:sections.image_with_text.settings.light_media.label" },
    { "type": "range", "id": "parallax", "min": 0, "max": 15, "step": 1, "unit": "%", "label": "t:common.parallax", "default": 3 },
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow", "default": "Technologie" },
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "Une pression pensée comme un geste, pas comme une machine." },
    { "type": "textarea", "id": "text", "label": "t:common.text" },
    { "type": "text", "id": "button_label", "label": "t:common.button_label" },
    { "type": "url", "id": "button_link", "label": "t:common.button_link" },
    { "type": "header", "content": "t:common.layout" },
    { "type": "text", "id": "anchor", "label": "t:common.anchor", "info": "t:common.anchor_info" },
    { "type": "checkbox", "id": "flush_top", "default": true, "label": "t:common.flush_top" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.image_with_text.blocks.item.name",
      "settings": [
        { "type": "text", "id": "title", "label": "t:common.title", "default": "Compression séquentielle" },
        { "type": "textarea", "id": "text", "label": "t:common.text" }
      ]
    },
    {
      "type": "paragraph",
      "name": "t:sections.image_with_text.blocks.paragraph.name",
      "settings": [{ "type": "textarea", "id": "text", "label": "t:common.text" }]
    },
    {
      "type": "quote",
      "name": "t:sections.image_with_text.blocks.quote.name",
      "settings": [{ "type": "textarea", "id": "text", "label": "t:common.text" }]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.name",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
