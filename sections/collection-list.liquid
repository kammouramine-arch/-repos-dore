{%- comment -%}
  Collection list
  Large editorial tiles that link straight into real collections.
{%- endcomment -%}

<section class="section scheme-{{ section.settings.color_scheme }}">
  <div class="wrap">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow eyebrow--gold" data-reveal="fade">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2" data-reveal>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        <a
          class="card"
          href="{{ coll.url | default: routes.all_products_collection_url }}"
          data-reveal="scale"
          style="--delay:{{ forloop.index0 | times: 90 }}ms"
          {{ block.shopify_attributes }}
        >
          <div class="card__media media media--3-4 media--zoom">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 900px) 32vw, 90vw',
                  alt: block.settings.image.alt | default: coll.title | escape
              }}
            {%- elsif coll.featured_image != blank -%}
              {{
                coll.featured_image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 900px) 32vw, 90vw',
                  alt: coll.title | escape
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          <div class="card__body">
            <h3 class="card__title">{{ block.settings.title | default: coll.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="card__sub">{{ block.settings.text | escape }}</p>
            {%- elsif coll != blank -%}
              <p class="card__sub">{{ 'sections.collection.product_count' | t: count: coll.all_products_count }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "section",
  "class": "collection-list-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:common.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:common.heading", "default": "Explorer" },
    {
      "type": "select",
      "id": "columns",
      "label": "t:common.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:common.color_scheme",
      "options": [
        { "value": "light", "label": "t:common.scheme_light" },
        { "value": "sand", "label": "t:common.scheme_sand" },
        { "value": "stone", "label": "t:common.scheme_stone" },
        { "value": "dark", "label": "t:common.scheme_dark" }
      ],
      "default": "light"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_list.block_collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:common.collection" },
        { "type": "image_picker", "id": "image", "label": "t:common.image", "info": "t:sections.collection_list.image_info" },
        { "type": "text", "id": "title", "label": "t:common.heading" },
        { "type": "text", "id": "text", "label": "t:common.text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
