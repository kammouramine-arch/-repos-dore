# ---------------------------------------------------------------------------
# AMYN — variables d'environnement
#
# Copiez ce fichier en `.env.local` pour le développement, et reportez les
# mêmes clés dans Vercel (Project → Settings → Environment Variables).
#
# ⚠️ Ne committez JAMAIS `.env.local` : il est déjà ignoré par git.
# Aucune de ces valeurs n'est lue par le navigateur — elles ne servent que
# dans la route serveur /api/contact.
# ---------------------------------------------------------------------------

# Clé d'envoi Resend (https://resend.com → API Keys).
# Sans elle : en développement la demande est écrite dans la console,
# en production le formulaire répond proprement « service indisponible ».
RESEND_API_KEY=

# Adresse qui reçoit les demandes.
# Le domaine amyn.agency a des MX OVH actifs : une boîte y reçoit bien.
# Par défaut : contact@amyn.agency
CONTACT_TO_EMAIL=

# Expéditeur technique (visible uniquement dans votre boîte de réception ;
# c'est le Reply-To qui porte l'adresse du prospect).
# Tant qu'aucun domaine n'est vérifié chez Resend, laissez vide :
# la valeur par défaut "AMYN <onboarding@resend.dev>" fonctionne.
# Une fois un domaine vérifié : "AMYN <contact@amyn.agency>"
CONTACT_FROM_EMAIL=
