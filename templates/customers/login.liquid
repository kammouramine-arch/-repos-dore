<section class="section account">
  <div class="wrap wrap--narrow account__narrow">
    <h1 class="h2">{{ 'customer.login.title' | t }}</h1>

    {% form 'customer_login', class: 'form-card', novalidate: 'novalidate' %}
      {%- if form.errors -%}
        <p class="form__note form__note--error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <label class="field">
        <span class="field__label">{{ 'customer.login.email' | t }}</span>
        <input class="input" type="email" name="customer[email]" autocomplete="email" required>
      </label>

      {%- if form.password_needed -%}
        <label class="field">
          <span class="field__label">{{ 'customer.login.password' | t }}</span>
          <input class="input" type="password" name="customer[password]" autocomplete="current-password" required>
        </label>
        <p style="margin-top:.75rem"><a class="text-link" href="#recover">{{ 'customer.login.forgot_password' | t }}</a></p>
      {%- endif -%}

      <button class="btn btn--block" type="submit" style="margin-top:1.5rem">{{ 'customer.login.submit' | t }}</button>
      <p class="account__alt"><a class="text-link" href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a></p>
    {% endform %}

    <div id="recover" class="account__recover">
      {% form 'recover_customer_password', class: 'form-card' %}
        <h2 class="h4">{{ 'customer.recover_password.title' | t }}</h2>
        <p class="muted">{{ 'customer.recover_password.subtext' | t }}</p>

        {%- if form.posted_successfully? -%}
          <p class="form__note form__note--success" role="status">{{ 'customer.recover_password.success' | t }}</p>
        {%- endif -%}

        <label class="field">
          <span class="field__label">{{ 'customer.login.email' | t }}</span>
          <input class="input" type="email" name="email" required>
        </label>

        <button class="btn btn--ghost btn--block" type="submit" style="margin-top:1.25rem">{{ 'customer.recover_password.submit' | t }}</button>
      {% endform %}
    </div>

    {%- if shop.checkout.guest_login -%}
      <div class="form-card">
        <h2 class="h4">{{ 'customer.login.guest_title' | t }}</h2>
        {% form 'guest_login' %}
          <button class="btn btn--ghost btn--block" type="submit">{{ 'customer.login.guest_continue' | t }}</button>
        {% endform %}
      </div>
    {%- endif -%}
  </div>
</section>
