<section class="section account">
  <div class="wrap wrap--narrow account__narrow">
    <h1 class="h2">{{ 'customer.activate_account.title' | t }}</h1>
    <p class="muted">{{ 'customer.activate_account.subtext' | t }}</p>

    {% form 'activate_customer_password', class: 'form-card' %}
      {%- if form.errors -%}
        <p class="form__note form__note--error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <label class="field">
        <span class="field__label">{{ 'customer.activate_account.password' | t }}</span>
        <input class="input" type="password" name="customer[password]" autocomplete="new-password" required>
      </label>
      <label class="field">
        <span class="field__label">{{ 'customer.activate_account.password_confirm' | t }}</span>
        <input class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </label>

      <button class="btn btn--block" type="submit" style="margin-top:1.5rem">{{ 'customer.activate_account.submit' | t }}</button>
      <button class="btn btn--ghost btn--block" type="submit" name="decline" style="margin-top:.75rem">{{ 'customer.activate_account.decline' | t }}</button>
    {% endform %}
  </div>
</section>
