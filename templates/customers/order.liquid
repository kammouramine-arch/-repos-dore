<section class="page-hero">
  <div class="wrap">
    <div class="page-hero__inner">
      <p class="eyebrow">{{ 'customer.orders.title' | t }}</p>
      <h1 class="h1">{{ order.name }}</h1>
      <p class="lead">{{ order.created_at | date: format: 'on_date' }}</p>
    </div>
  </div>
</section>

<section class="section" style="padding-top:clamp(1rem,3vw,2rem)">
  <div class="wrap wrap--narrow">
    <div class="cart-lines">
      {%- for line_item in order.line_items -%}
        <div class="drawer-line">
          <div class="drawer-line__media">
            {%- if line_item.image -%}
              <img src="{{ line_item.image | image_url: width: 200 }}" alt="{{ line_item.image.alt | escape }}" width="100" height="100" loading="lazy">
            {%- endif -%}
          </div>
          <div style="display:flex;flex-direction:column;flex:1;min-width:0">
            <p class="drawer-line__name">{{ line_item.title }}</p>
            <p class="drawer-line__meta">{{ 'cart.line.quantity' | t }} {{ line_item.quantity }}</p>
            <p class="drawer-line__price">{{ line_item.final_line_price | money }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="cart-foot">
      <div class="cart-foot__total"><span class="muted">{{ 'cart.subtotal' | t }}</span><strong>{{ order.subtotal_price | money }}</strong></div>
      <div class="cart-foot__total"><span class="muted">{{ 'customer.orders.total' | t }}</span><strong>{{ order.total_price | money }}</strong></div>
    </div>

    <div class="prose" style="margin-top:2.5rem">
      <h2 class="h4">{{ 'customer.account.addresses' | t }}</h2>
      {{ order.shipping_address | format_address }}
    </div>
  </div>
</section>
