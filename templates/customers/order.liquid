{%- comment -%} Single order {%- endcomment -%}
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{{ order.created_at | date: format: 'date' }}</span>
      <h1 class="h2">{{ 'customer.order.title' | t: name: order.name }}</h1>
    </div>

    <table>
      <thead>
        <tr>
          <th style="text-align:left; padding:.75rem 1rem .75rem 0; border-bottom:1px solid var(--c-line)">{{ 'customer.order.product' | t }}</th>
          <th style="text-align:right; padding:.75rem 1rem; border-bottom:1px solid var(--c-line)">{{ 'customer.order.quantity' | t }}</th>
          <th style="text-align:right; padding:.75rem 0 .75rem 1rem; border-bottom:1px solid var(--c-line)">{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line in order.line_items -%}
          <tr style="font-size:var(--t-small)">
            <td style="padding:.9rem 1rem .9rem 0; border-bottom:1px solid var(--c-line)">
              {{ line.title }}
            </td>
            <td style="padding:.9rem 1rem; text-align:right; border-bottom:1px solid var(--c-line)">{{ line.quantity }}</td>
            <td style="padding:.9rem 0 .9rem 1rem; text-align:right; border-bottom:1px solid var(--c-line)">{{ line.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    <div style="max-width:340px; margin-left:auto; margin-top:var(--sp-4)">
      <div class="cart-total"><span>{{ 'customer.order.subtotal' | t }}</span><span>{{ order.line_items_subtotal_price | money }}</span></div>
      {%- for shipping in order.shipping_methods -%}
        <div class="cart-total"><span>{{ shipping.title }}</span><span>{{ shipping.price | money }}</span></div>
      {%- endfor -%}
      <div class="cart-total"><span>{{ 'customer.order.total' | t }}</span><span class="cart-total__value">{{ order.total_price | money }}</span></div>
    </div>

    <div class="split split--50" style="margin-top:var(--sp-6)">
      <div>
        <h2 class="h4" style="margin-bottom:1rem">{{ 'customer.order.billing_address' | t }}</h2>
        <div class="muted" style="font-size:var(--t-small)">{{ order.billing_address | format_address }}</div>
      </div>
      <div>
        <h2 class="h4" style="margin-bottom:1rem">{{ 'customer.order.shipping_address' | t }}</h2>
        <div class="muted" style="font-size:var(--t-small)">{{ order.shipping_address | format_address }}</div>
      </div>
    </div>

    <a class="link" href="{{ routes.account_url }}" style="display:inline-block; margin-top:var(--sp-5)">
      {{ 'customer.order.back' | t }}
    </a>
  </div>
</section>
