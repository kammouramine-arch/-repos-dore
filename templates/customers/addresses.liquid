{%- comment -%} Customer addresses {%- endcomment -%}
<section class="section">
  <div class="wrap wrap--narrow">
    <div class="section-head section-head--split">
      <h1 class="h2">{{ 'customer.addresses.title' | t }}</h1>
      <a class="link" href="{{ routes.account_url }}">{{ 'customer.order.back' | t }}</a>
    </div>

    {%- paginate customer.addresses by 10 -%}
      <div style="display:grid; gap:var(--sp-4)">
        {%- for address in customer.addresses -%}
          <div style="border:1px solid var(--c-line); padding:var(--sp-4)">
            <div class="muted" style="font-size:var(--t-small)">{{ address | format_address }}</div>

            <div style="display:flex; gap:1.25rem; margin-top:1.25rem">
              {%- form 'customer_address', address -%}
                <button class="link" type="submit">{{ 'customer.addresses.edit' | t }}</button>
              {%- endform -%}
            </div>
          </div>
        {%- else -%}
          <p class="muted">{{ 'customer.addresses.none' | t }}</p>
        {%- endfor -%}
      </div>

      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}

    <div style="margin-top:var(--sp-6); border-top:1px solid var(--c-line); padding-top:var(--sp-5)">
      <h2 class="h4" style="margin-bottom:1.5rem">{{ 'customer.addresses.add_new' | t }}</h2>

      {%- form 'customer_address', customer.new_address -%}
        <div style="display:grid; gap:1.25rem">
          <div class="field">
            <label class="field__label" for="addr-first">{{ 'customer.register.first_name' | t }}</label>
            <input class="input" id="addr-first" type="text" name="address[first_name]" autocomplete="given-name">
          </div>
          <div class="field">
            <label class="field__label" for="addr-last">{{ 'customer.register.last_name' | t }}</label>
            <input class="input" id="addr-last" type="text" name="address[last_name]" autocomplete="family-name">
          </div>
          <div class="field">
            <label class="field__label" for="addr-1">{{ 'customer.addresses.address1' | t }}</label>
            <input class="input" id="addr-1" type="text" name="address[address1]" autocomplete="address-line1">
          </div>
          <div class="field">
            <label class="field__label" for="addr-city">{{ 'customer.addresses.city' | t }}</label>
            <input class="input" id="addr-city" type="text" name="address[city]" autocomplete="address-level2">
          </div>
          <div class="field">
            <label class="field__label" for="addr-zip">{{ 'customer.addresses.zip' | t }}</label>
            <input class="input" id="addr-zip" type="text" name="address[zip]" autocomplete="postal-code">
          </div>
          <div class="field">
            <label class="field__label" for="addr-country">{{ 'customer.addresses.country' | t }}</label>
            <div class="select-wrap">
              <select class="select" id="addr-country" name="address[country]" autocomplete="country">
                {{ country_option_tags }}
              </select>
            </div>
          </div>
          <button class="btn" type="submit" style="justify-self:start">
            <span>{{ 'customer.addresses.save' | t }}</span>
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
