<section class="section account">
  <div class="wrap">
    <div class="account__head">
      <h1 class="h2">{{ 'customer.addresses.title' | t }}</h1>
      <a class="text-link" href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a>
    </div>

    {%- paginate customer.addresses by 10 -%}
      <div class="address-grid">
        <div class="form-card">
          <h2 class="h4">{{ 'customer.addresses.add_new' | t }}</h2>
          {% form 'customer_address', customer.new_address %}
            <div class="form-grid">
              <label class="field"><span class="field__label">{{ 'customer.addresses.first_name' | t }}</span>
                <input class="input" type="text" name="address[first_name]" autocomplete="given-name"></label>
              <label class="field"><span class="field__label">{{ 'customer.addresses.last_name' | t }}</span>
                <input class="input" type="text" name="address[last_name]" autocomplete="family-name"></label>
              <label class="field field--full"><span class="field__label">{{ 'customer.addresses.company' | t }}</span>
                <input class="input" type="text" name="address[company]" autocomplete="organization"></label>
              <label class="field field--full"><span class="field__label">{{ 'customer.addresses.address1' | t }}</span>
                <input class="input" type="text" name="address[address1]" autocomplete="address-line1"></label>
              <label class="field field--full"><span class="field__label">{{ 'customer.addresses.address2' | t }}</span>
                <input class="input" type="text" name="address[address2]" autocomplete="address-line2"></label>
              <label class="field"><span class="field__label">{{ 'customer.addresses.city' | t }}</span>
                <input class="input" type="text" name="address[city]" autocomplete="address-level2"></label>
              <label class="field"><span class="field__label">{{ 'customer.addresses.zip' | t }}</span>
                <input class="input" type="text" name="address[zip]" autocomplete="postal-code"></label>
              <label class="field field--full"><span class="field__label">{{ 'customer.addresses.country' | t }}</span>
                <select class="select" name="address[country]" data-default="{{ form.country }}">{{ country_option_tags }}</select></label>
              <label class="field field--full"><span class="field__label">{{ 'customer.addresses.phone' | t }}</span>
                <input class="input" type="tel" name="address[phone]" autocomplete="tel"></label>
            </div>

            <label class="checkbox" style="margin-top:1.25rem">
              <input type="checkbox" name="address[default]">
              <span>{{ 'customer.addresses.set_default' | t }}</span>
            </label>

            <button class="btn btn--block" type="submit" style="margin-top:1.5rem">{{ 'customer.addresses.save' | t }}</button>
          {% endform %}
        </div>

        {%- for address in customer.addresses -%}
          <div class="form-card">
            <h2 class="h4">
              {%- if address == customer.default_address -%}
                {{ 'customer.addresses.default' | t }}
              {%- else -%}
                {{ 'customer.addresses.title' | t }}
              {%- endif -%}
            </h2>
            <div class="rte">{{ address | format_address }}</div>
            {% form 'customer_address', address %}
              <input type="hidden" name="_method" value="delete">
              <button class="text-link" type="submit" onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t }}')">
                {{ 'customer.addresses.delete' | t }}
              </button>
            {% endform %}
          </div>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>
