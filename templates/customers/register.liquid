<section class="page-hero">
  <div class="wrap">
    <div class="page-hero__inner">
      <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
      <h1 class="h1">{{ 'customer.register.title' | t }}</h1>
    </div>
  </div>
</section>

<section class="section" style="padding-top:clamp(1rem,3vw,2rem)">
  <div class="wrap wrap--narrow">
    <div class="form-card" style="max-width:34rem;margin-inline:auto">
      {%- form 'create_customer', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="field__error is-visible" style="margin-bottom:1.5rem" role="alert">{{ form.errors.messages.form }}</div>
        {%- endif -%}
        <div class="form-grid">
          <label class="field">
            <span class="field__label">{{ 'contact.form.first_name' | t }}</span>
            <input class="input" type="text" name="customer[first_name]" autocomplete="given-name">
          </label>
          <label class="field">
            <span class="field__label">{{ 'contact.form.last_name' | t }}</span>
            <input class="input" type="text" name="customer[last_name]" autocomplete="family-name">
          </label>
          <label class="field field--full">
            <span class="field__label">{{ 'contact.form.email' | t }}</span>
            <input class="input" type="email" name="customer[email]" autocomplete="email" required>
          </label>
          <label class="field field--full">
            <span class="field__label">{{ 'customer.login.password' | t }}</span>
            <input class="input" type="password" name="customer[password]" autocomplete="new-password" required>
          </label>
        </div>
        <button class="btn btn--block" type="submit" style="margin-top:1.5rem">{{ 'customer.register.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
