<section class="section account">
  <div class="wrap wrap--narrow account__narrow">
    <h1 class="h2">{{ 'customer.register.title' | t }}</h1>

    {% form 'create_customer', class: 'form-card', novalidate: 'novalidate' %}
      {%- if form.errors -%}
        <p class="form__note form__note--error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="form-grid">
        <label class="field">
          <span class="field__label">{{ 'customer.register.first_name' | t }}</span>
          <input class="input" type="text" name="customer[first_name]" autocomplete="given-name">
        </label>
        <label class="field">
          <span class="field__label">{{ 'customer.register.last_name' | t }}</span>
          <input class="input" type="text" name="customer[last_name]" autocomplete="family-name">
        </label>
        <label class="field field--full">
          <span class="field__label">{{ 'customer.register.email' | t }}</span>
          <input class="input" type="email" name="customer[email]" autocomplete="email" required>
        </label>
        <label class="field field--full">
          <span class="field__label">{{ 'customer.register.password' | t }}</span>
          <input class="input" type="password" name="customer[password]" autocomplete="new-password" required>
        </label>
      </div>

      <button class="btn btn--block" type="submit" style="margin-top:1.5rem">{{ 'customer.register.submit' | t }}</button>
      <p class="account__alt"><a class="text-link" href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a></p>
    {% endform %}
  </div>
</section>
