<section class="section account">
  <div class="wrap wrap--narrow account__narrow">
    <h1 class="h2">{{ 'customer.reset_password.title' | t }}</h1>

    {% form 'reset_customer_password', class: 'form-card' %}
      {%- if form.errors -%}
        <p class="form__note form__note--error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <label class="field">
        <span class="field__label">{{ 'customer.reset_password.password' | t }}</span>
        <input class="input" type="password" name="customer[password]" autocomplete="new-password" required>
      </label>
      <label class="field">
        <span class="field__label">{{ 'customer.reset_password.password_confirm' | t }}</span>
        <input class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </label>

      <button class="btn btn--block" type="submit" style="margin-top:1.5rem">{{ 'customer.reset_password.submit' | t }}</button>
    {% endform %}
  </div>
</section>
