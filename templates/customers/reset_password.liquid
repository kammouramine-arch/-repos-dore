{%- comment -%} Password reset {%- endcomment -%}
<section class="section">
  <div class="wrap" style="max-width:460px">
    <h1 class="h2 center" style="margin-bottom:var(--sp-4)">{{ 'customer.reset_password.title' | t }}</h1>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <p class="form-error" style="margin-bottom:1.5rem">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div style="display:grid; gap:1.25rem">
        <div class="field">
          <label class="field__label" for="reset-password">{{ 'customer.reset_password.password' | t }}</label>
          <input class="input" id="reset-password" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label class="field__label" for="reset-confirm">{{ 'customer.reset_password.confirm' | t }}</label>
          <input class="input" id="reset-confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
        <button class="btn btn--block" type="submit"><span>{{ 'customer.reset_password.submit' | t }}</span></button>
      </div>
    {%- endform -%}
  </div>
</section>
