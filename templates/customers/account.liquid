<section class="page-hero">
  <div class="wrap">
    <div class="page-hero__inner">
      <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
      <h1 class="h1">{{ customer.first_name | default: customer.email }}</h1>
      <p class="lead"><a href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t }}</a> · <a href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a></p>
    </div>
  </div>
</section>

<section class="section" style="padding-top:clamp(1rem,3vw,2rem)">
  <div class="wrap wrap--narrow">
    <h2 class="h3" style="margin-bottom:1.5rem">{{ 'customer.orders.title' | t }}</h2>
    {%- paginate customer.orders by 12 -%}
      {%- if customer.orders.size > 0 -%}
        <table class="compare">
          <thead>
            <tr>
              <th scope="col">{{ 'customer.orders.order' | t }}</th>
              <th scope="col">{{ 'customer.orders.date' | t }}</th>
              <th scope="col">{{ 'customer.orders.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <th scope="row"><a href="{{ order.customer_url }}">{{ order.name }}</a></th>
                <td>{{ order.created_at | date: format: 'on_date' }}</td>
                <td>{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}
        <p class="muted">{{ 'customer.orders.none' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
