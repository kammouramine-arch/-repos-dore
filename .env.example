# =============================================================================
# DEVISIA — variables d'environnement
# Copiez ce fichier en `.env` puis renseignez vos valeurs.
# Aucun secret ne doit être committé.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
# URL publique de l'application (utilisée dans les emails et les liens de devis)
APP_URL=http://localhost:3000
# Secret de session — générez-le avec : openssl rand -base64 48
AUTH_SECRET=changez-moi-par-une-valeur-aleatoire-longue

# --- Base de données ---------------------------------------------------------
# PostgreSQL 14+ (compatible Supabase, Neon, RDS…)
DATABASE_URL="postgresql://devisia:devisia@127.0.0.1:5432/devisia?schema=public"
# Connexion directe (migrations) si votre hébergeur utilise un pooler
DIRECT_URL="postgresql://devisia:devisia@127.0.0.1:5432/devisia?schema=public"
# Base utilisée par la suite de tests d'intégration
TEST_DATABASE_URL="postgresql://devisia:devisia@127.0.0.1:5432/devisia_test?schema=public"

# --- Intelligence artificielle ----------------------------------------------
# Renseignez ANTHROPIC_API_KEY pour activer Claude : c'est la seule variable
# requise. Sans clé, DEVISIA reste pleinement fonctionnel avec son moteur local
# (rapprochement catalogue), et l'interface l'indique explicitement.
# La clé est lue uniquement côté serveur ; ne la préfixez jamais NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Modèle Claude utilisé (facultatif, valeur par défaut : claude-opus-5).
ANTHROPIC_MODEL=claude-opus-5
# Forçage explicite du fournisseur (facultatif) : `local` désactive Claude même
# si une clé est présente ; `anthropic` l'impose. Vide = déduit de la clé.
AI_PROVIDER=

# --- Transcription audio (API compatible OpenAI) -----------------------------
# `none`   : la dictée du navigateur est utilisée (aucune clé requise).
# `openai` : transcription serveur (OpenAI, Groq, Whisper auto-hébergé…).
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# --- Emails transactionnels --------------------------------------------------
# `console` : les emails sont journalisés, rien n'est envoyé (développement).
# `resend`  : envoi réel via Resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="DEVISIA <bonjour@devisia.fr>"

# --- Stockage des fichiers ---------------------------------------------------
# `local` : disque (développement). `s3` : stockage objet compatible S3
# (AWS S3, Supabase Storage, Cloudflare R2, MinIO) — requis en production.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=eu-west-3
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- SMS / WhatsApp (facultatif) ---------------------------------------------
# Non requis pour le MVP : les relances passent par email.
MESSAGING_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Paiements (Stripe) ------------------------------------------------------
# Sans ces variables, l'application fonctionne mais la souscription est fermée.
STRIPE_SECRET_KEY=
# Clé publique : seule variable Stripe exposée au navigateur.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants de tarifs mensuels créés dans le tableau de bord Stripe.
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTREPRISE=

# --- Notifications push mobiles (Expo) ---------------------------------------
# Aucune clé n'est requise pour envoyer : APNs et FCM sont configurés dans EAS.
# Un jeton d'accès Expo permet des envois authentifiés (recommandé en production).
EXPO_ACCESS_TOKEN=
# Mettre à false pour couper tout envoi push (recette, environnements internes).
PUSH_ENABLED=true

# --- Tâches planifiées -------------------------------------------------------
# Secret partagé protégeant POST /api/cron/relances
CRON_SECRET=
