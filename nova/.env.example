# ---------------------------------------------------------------------------
# Nova — environment configuration
# Copy to `.env` (git-ignored) and adjust. Nothing here is secret at runtime:
# every EXPO_PUBLIC_* value is compiled into the app bundle.
# ---------------------------------------------------------------------------

# Geocoding / destination search (Nominatim-compatible).
# The default is OpenStreetMap's public instance: fine for development, rate
# limited and not permitted for production traffic. Point this at your own.
EXPO_PUBLIC_PLACES_BASE_URL=https://nominatim.openstreetmap.org

# Route planning (OSRM-compatible).
# The default is the OSRM demo server — development only, no uptime guarantee.
EXPO_PUBLIC_ROUTING_BASE_URL=https://router.project-osrm.org

# Sent as User-Agent on every request. Public OSM services require a
# contactable identifier and throttle anonymous traffic.
EXPO_PUBLIC_USER_AGENT=NovaDrivingCompanion/1.0 (contact@your-domain.example)

# ---------------------------------------------------------------------------
# Build-time only (read by app.config.ts, never shipped in the JS bundle)
# ---------------------------------------------------------------------------

# Required for Android builds — Google Maps SDK for Android key.
# iOS renders Apple Maps and needs no key.
GOOGLE_MAPS_ANDROID_API_KEY=
