# ---------------------------------------------------------------------------
# AMYN OUTREACH — configuration
#
# Copier ce fichier en `.env` puis remplir. `.env` n'est JAMAIS commite
# (il est dans .gitignore). Aucun secret ne doit apparaitre ici.
# ---------------------------------------------------------------------------

# --- Base de donnees (SQLite : un simple fichier) --------------------------
# Chemin relatif au dossier prisma/. Le dossier data/ est ignore par Git :
# la base contient des donnees de prospects, elle ne doit jamais etre commitee.
DATABASE_URL=file:../data/amyn.db

# --- SECURITE : mode simulation --------------------------------------------
# true  = les emails sont SIMULES et journalises, rien ne part.
# false = envoi reel autorise (et seulement si MAIL_TRANSPORT=smtp et que la
#         configuration SMTP est complete).
# Laisser sur true tant que le test d'envoi n'est pas concluant.
DRY_RUN=true

# --- Identite de l'expediteur ----------------------------------------------
MAIL_FROM_NAME=AMYN
MAIL_FROM_EMAIL=contact@amyn.agency
MAIL_REPLY_TO=contact@amyn.agency

# --- Transport email (interchangeable) --------------------------------------
# "dry-run" (defaut) : simulation, aucun reseau.
# "smtp"             : envoi reel via nodemailer.
MAIL_TRANSPORT=dry-run

# --- SMTP (OVHcloud MX Plan / Zimbra pour contact@amyn.agency) --------------
# A remplir uniquement dans .env, jamais ici.
#
# Valeurs OVHcloud (source : documentation OVHcloud, solution Zimbra) :
#   SMTP_HOST=ssl0.ovh.net       (alias : smtp.mail.ovh.net)
#   SMTP_PORT=465                (SSL/TLS implicite)
#   SMTP_SECURE=true
#   SMTP_USER=contact@amyn.agency  <- l'adresse complete, pas un login court
#   SMTP_PASSWORD=<mot de passe de la boite>
#
# Variante si le port 465 est bloque par le reseau :
#   SMTP_PORT=587 avec SMTP_SECURE=false (STARTTLS)
#
# Autres solutions OVHcloud : Email Pro -> proN.mail.ovh.net,
# Hosted Exchange -> exN.mail.ovh.net. Le serveur exact figure dans
# l'espace client OVHcloud.
#
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=

# --- IMAP (lecture des reponses recues dans contact@amyn.agency) ------------
# A remplir uniquement dans .env, jamais ici.
#
# Valeurs OVHcloud (source : documentation OVHcloud, solution Zimbra) :
#   IMAP_HOST=ssl0.ovh.net       (alias : imap.mail.ovh.net)
#   IMAP_PORT=993                (SSL/TLS implicite)
#   IMAP_SECURE=true
#   IMAP_USER=contact@amyn.agency  <- l'adresse complete, pas un login court
#   IMAP_PASSWORD=<mot de passe de la boite>
#
# La boite est ouverte en LECTURE SEULE : aucun message n'est supprime,
# deplace, ni meme marque comme lu.
#
# IMAP_HOST=
# IMAP_PORT=
# IMAP_SECURE=
# IMAP_USER=
# IMAP_PASSWORD=

# Dossier lu (defaut : INBOX).
IMAP_FOLDER=INBOX
# Plafond de messages traites par execution.
IMAP_MAX_MESSAGES=200
# Ne lire que les messages recus depuis N jours (0 = pas de limite).
IMAP_SINCE_DAYS=90

# --- Politique d'envoi -------------------------------------------------------
# Les valeurs ci-dessous ne sont que des VALEURS DE REPLI. La politique
# effective vit en base et se modifie a chaud, sans redemarrage :
#
#   npm run amyn -- policy                  (voir)
#   npm run amyn -- policy dailyLimit 5     (modifier)
#
# Elle couvre aussi la fenetre horaire, le week-end, les relances, le delai de
# recontact, le score minimum et la reponse automatique.
#
# --- Garde-fous d'envoi ------------------------------------------------------
# Plafond quotidien. Protege la reputation du domaine.
DAILY_SEND_LIMIT=15
# Delai minimum entre deux envois, en secondes.
MIN_DELAY_BETWEEN_SENDS_SECONDS=180

# --- Redaction par Claude (facultatif) --------------------------------------
# Sans cle, les emails sont rediges par le moteur template (deterministe,
# base sur les memes preuves). Avec cle, Claude redige puis le verificateur
# anti-invention tranche.
# ANTHROPIC_API_KEY=

# --- Sources de prospects (facultatif) --------------------------------------
# OpenStreetMap fonctionne sans cle. Google Places ameliore la couverture.
# Sirene (INSEE) donne les donnees legales des entreprises. Les deux sont
# facultatives : sans elles, OpenStreetMap suffit.
# GOOGLE_PLACES_API_KEY=
# SIRENE_API_KEY=
