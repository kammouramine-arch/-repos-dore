# ---------------------------------------------------------------------------
# AMYN OUTREACH — configuration
#
# Copier ce fichier en `.env` puis remplir. `.env` n'est JAMAIS commite
# (il est dans .gitignore). Aucun secret ne doit apparaitre ici.
# ---------------------------------------------------------------------------

# --- Base de donnees (SQLite : un simple fichier) --------------------------
# Chemin relatif au dossier prisma/. Le dossier data/ est ignore par Git :
# la base contient des donnees de prospects, elle ne doit jamais etre commitee.
DATABASE_URL=file:../data/amyn.db

# --- SECURITE : mode simulation --------------------------------------------
# true  = les emails sont SIMULES et journalises, rien ne part.
# false = envoi reel autorise (et seulement si MAIL_TRANSPORT=smtp et que la
#         configuration SMTP est complete).
# Laisser sur true tant que le test d'envoi n'est pas concluant.
DRY_RUN=true

# --- Identite de l'expediteur ----------------------------------------------
MAIL_FROM_NAME=AMYN
MAIL_FROM_EMAIL=contact@amyn.agency
MAIL_REPLY_TO=contact@amyn.agency

# --- Transport email (interchangeable) --------------------------------------
# "dry-run" (defaut) : simulation, aucun reseau.
# "smtp"             : envoi reel via nodemailer.
MAIL_TRANSPORT=dry-run

# --- SMTP (OVHcloud / Zimbra pour contact@amyn.agency) ----------------------
# A remplir uniquement dans .env, jamais ici.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Garde-fous d'envoi ------------------------------------------------------
# Plafond quotidien. Protege la reputation du domaine.
DAILY_SEND_LIMIT=15
# Delai minimum entre deux envois, en secondes.
MIN_DELAY_BETWEEN_SENDS_SECONDS=180

# --- Redaction par Claude (facultatif) --------------------------------------
# Sans cle, les emails sont rediges par le moteur template (deterministe,
# base sur les memes preuves). Avec cle, Claude redige puis le verificateur
# anti-invention tranche.
# ANTHROPIC_API_KEY=

# --- Sources de prospects (facultatif) --------------------------------------
# OpenStreetMap fonctionne sans cle. Google Places ameliore la couverture.
# Sirene (INSEE) donne les donnees legales des entreprises. Les deux sont
# facultatives : sans elles, OpenStreetMap suffit.
# GOOGLE_PLACES_API_KEY=
# SIRENE_API_KEY=
