# ---------------------------------------------------------------------------
# AMYN OUTREACH — configuration
# Copier ce fichier en `.env` puis remplir. Le fichier `.env` n'est JAMAIS commite.
# ---------------------------------------------------------------------------

# --- Base de donnees (SQLite : un simple fichier) --------------------------
DATABASE_URL="file:../data/amyn.db"

# --- SECURITE : mode simulation --------------------------------------------
# true  = AUCUN email ne peut partir. Tout envoi est simule et journalise.
# false = les envois reels sont autorises (PAS AVANT LE LOT 6).
# Laisser sur true.
DRY_RUN=true

# --- Identite de l'expediteur ----------------------------------------------
MAIL_FROM_NAME="AMYN"
MAIL_FROM_EMAIL="contact@amyn.agency"
MAIL_REPLY_TO="contact@amyn.agency"

# --- Transport email (interchangeable) --------------------------------------
# Valeurs possibles : "dry-run" (defaut) | "smtp"
# "smtp" n'est PAS implemente dans le lot 1 : le code refuse de demarrer si
# on le selectionne. Prevu pour OVHcloud / Zimbra au lot 5.
MAIL_TRANSPORT=dry-run

# Renseignes plus tard, au lot 5 (OVHcloud Zimbra) :
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=contact@amyn.agency
# SMTP_PASSWORD=

# --- Garde-fous d'envoi ------------------------------------------------------
# Plafond quotidien. Protege la reputation du domaine.
DAILY_SEND_LIMIT=15
# Delai minimum entre deux envois, en secondes.
MIN_DELAY_BETWEEN_SENDS_SECONDS=180

# --- Cles API (lots 3 et 4, pas necessaires maintenant) ---------------------
# ANTHROPIC_API_KEY=
# GOOGLE_PLACES_API_KEY=
