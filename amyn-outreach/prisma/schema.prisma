// ===========================================================================
// AMYN OUTREACH — modele de donnees complet
//
// Chaine metier :
//   PROSPECT > RECHERCHE > AUDIT > CONTACT > SCORE > EMAIL > ENVOI > REPONSE
//   > LEAD > CLIENT > ONBOARDING > PROJET > PRODUCTION > LIVRAISON > CARE
//
// INVARIANTS STRUCTURELS (garantis par le modele, pas par des consignes) :
//   1. Un email ne peut citer qu'une Issue existante, elle-meme adossee a un
//      AuditCheck VERIFIED. Pas de preuve => pas d'affirmation.
//   2. Un Contact porte toujours sa source. Une adresse devinee est
//      impossible : le champ `discoveryMethod` n'accepte pas "GUESS".
//   3. Tout envoi passe par des ComplianceCheck enregistres. Un echec bloque.
//   4. Toute action sensible laisse une trace dans ActivityLog.
//
// SQLite ne supporte pas les enums Prisma : les valeurs autorisees sont
// typees dans lib/domain/constants.ts.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PROSPECTION
// ---------------------------------------------------------------------------

model Prospect {
  id String @id @default(cuid())

  // Identite
  name       String
  legalName  String?
  sector     String
  city       String
  region     String?
  country    String  @default("FR")
  address    String?
  postalCode String?

  // --- Identifiants de deduplication -----------------------------------
  //
  // Trois cles, par ordre de fiabilite decroissante. Chacune est indexee :
  // reconnaitre un doublon coute une requete ciblee, jamais un parcours de
  // toute la base. C'est ce qui rend une base nationale tenable.
  //
  //   1. SIRET   — identifiant legal d'un etablissement. Sans ambiguite.
  //   2. domaine — deux entreprises ne partagent pas un site web.
  //   3. nameKey + code postal — repli quand ni l'un ni l'autre n'existe.
  //
  // Le repli est volontairement « nom + CODE POSTAL » et non « nom + ville » :
  // deux « Le Bistrot » a Paris sont deux entreprises differentes, et la
  // contrainte nom+ville les confondait. Le code postal descend a l'echelle
  // de l'arrondissement ou du quartier — a defaut d'etre parfait, il ne
  // fusionne plus deux commerces distincts d'une meme grande ville.
  //
  // NULL est autorise et repete : une entreprise sans SIRET connu n'entre pas
  // en collision avec toutes les autres entreprises sans SIRET.
  siret     String? @unique
  siren     String?
  domainKey String? @unique
  /// Nom normalise (casse, accents, formes juridiques retirees).
  nameKey   String?

  /// Code NAF de l'activite principale, quand la source le fournit.
  naf         String?
  /// Departement a deux ou trois caracteres (2A, 2B, 971...).
  departement String?

  /// Territoire ayant permis de decouvrir ce prospect. Tracabilite du balayage.
  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  // Presence en ligne
  //
  // `website` n'est renseigne que si l'appartenance du domaine a ete PROUVEE.
  // Un domaine plausible n'est pas un domaine verifie : ecrire a une
  // entreprise a propos d'un site qui n'est pas le sien est la pire erreur
  // possible — elle detruit la credibilite du message en une ligne.
  ///
  /// UNKNOWN    : jamais cherche
  /// CONFIRMED  : preuve d'appartenance trouvee (SIREN, adresse, telephone)
  /// NOT_FOUND  : cherche, aucun site trouve
  /// UNCONFIRMED: des candidats repondent, aucun ne prouve son appartenance
  /// PROVIDED   : fourni par la source (OSM, Google Places) ou saisi a la main
  /// ERROR      : la recherche a echoue ; consigne pour ne pas boucler dessus
  websiteStatus    String    @default("UNKNOWN")
  /// JSON : preuves ayant permis de confirmer le domaine, ou candidats rejetes.
  websiteEvidence  String?
  websiteCheckedAt DateTime?

  website           String?
  googleBusinessUrl String?
  googlePlaceId     String?
  instagramUrl      String?
  facebookUrl       String?
  phone             String?

  // Contact retenu (toujours issu d'un Contact trace)
  primaryContactId String?  @unique
  primaryContact   Contact? @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  // Audit
  auditStatus String    @default("PENDING") // PENDING | COMPLETE | INCOMPLETE | FAILED | BLOCKED_BY_ROBOTS
  auditNote   String?
  auditedAt   DateTime?

  // Scoring (0-100). rationale = JSON detaillant chaque composante.
  fitScore       Int?
  auditScore     Int?
  contactScore   Int?
  overallScore   Int?
  scoreRationale String?
  scoredAt       DateTime?

  // Qualification : le prospect merite-t-il d'etre contacte ?
  /// QUALIFIED | NOT_QUALIFIED | NEEDS_HUMAN | PENDING
  qualification       String    @default("PENDING")
  /// JSON : raisons retenues et blocages, pour pouvoir relire la decision
  qualificationReason String?
  qualifiedAt         DateTime?

  // Recommandation commerciale
  recommendedOffer String?
  recommendedPrice Int?
  offerRationale   String?

  // Cycle de vie
  status            String    @default("FOUND")
  blockedReason     String?
  lastInteractionAt DateTime?
  nextAction        String?
  nextActionAt      DateTime?

  // Tracabilite
  isDemo    Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues          Issue[]
  sources         Source[]
  contacts        Contact[]        @relation("ProspectContacts")
  auditRuns       AuditRun[]
  auditChecks     AuditCheck[]
  emailDrafts     EmailDraft[]
  sendLogs        SendLog[]
  replies         Reply[]
  statusEvents    StatusEvent[]
  campaignMembers CampaignMember[]
  client          Client?

  @@unique([nameKey, postalCode])
  @@index([status])
  @@index([city])
  @@index([overallScore])
  @@index([siren])
  @@index([nameKey])
  @@index([departement])
  @@index([territoryId])
  @@index([qualification])
  @@index([createdAt])
  @@index([websiteStatus])
  @@index([auditStatus])
}

/// Origine de chaque information. Obligation RGPD : pouvoir dire d'ou vient une donnee.
model Source {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  kind        String // WEBSITE | LEGAL_NOTICE | GOOGLE_BUSINESS | INSTAGRAM | DIRECTORY | OSM | SIRENE | MANUAL
  label       String
  url         String?
  note        String?
  rawData     String? // JSON brut renvoye par la source
  collectedAt DateTime @default(now())

  @@index([prospectId])
}

/// Un probleme PROUVE. N'existe que si un AuditCheck VERIFIED le demontre.
model Issue {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  type     String
  severity String @default("MEDIUM") // HIGH | MEDIUM | LOW
  title    String
  summary  String

  // La preuve
  evidenceUrl     String?
  evidenceSnippet String?
  evidenceNote    String?

  detectionMethod String   @default("AUTOMATED") // AUTOMATED | AI | MANUAL
  detectedAt      DateTime @default(now())

  auditCheckId String?     @unique
  auditCheck   AuditCheck? @relation(fields: [auditCheckId], references: [id], onDelete: SetNull)
  ruleId       String?
  confidence   String      @default("MEDIUM")

  @@index([prospectId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditRun {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  status String // COMPLETE | INCOMPLETE | FAILED | BLOCKED_BY_ROBOTS
  note   String?

  engineVersion String @default("1.0.0")
  userAgent     String

  pagesFetched Int @default(0)
  bytesFetched Int @default(0)
  requestsMade Int @default(0)
  rulesRun     Int @default(0)

  verifiedCount   Int @default(0)
  unverifiedCount Int @default(0)
  notFoundCount   Int @default(0)
  problemCount    Int @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  checks AuditCheck[]

  @@index([prospectId])
  @@index([startedAt])
}

/// Le resultat d'UNE regle. On conserve aussi ce qui n'a PAS pu etre prouve.
/// verdict : VERIFIED (prouve) | UNVERIFIED (insuffisant) | NOT_FOUND (cherche, absent)
model AuditCheck {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  auditRunId String
  auditRun   AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  ruleId    String
  ruleLabel String
  category  String

  verdict    String
  confidence String @default("MEDIUM")

  isProblem Boolean @default(false)
  issueType String?
  severity  String?

  /// Ce qui a ete OBSERVE. Factuel, chiffre quand mesurable.
  observation String
  /// COMMENT cela a ete observe.
  method      String

  targetUrl       String?
  evidenceSnippet String?
  evidenceData    String?

  checkedAt DateTime @default(now())
  issue     Issue?

  @@index([prospectId])
  @@index([auditRunId])
  @@index([verdict])
}

// ---------------------------------------------------------------------------
// CONTACTS
// ---------------------------------------------------------------------------

/// Une adresse email professionnelle PUBLIQUE, avec sa provenance.
/// discoveryMethod n'accepte aucune valeur de type "devinee" : c'est le
/// verrou structurel contre les adresses inventees.
model Contact {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation("ProspectContacts", fields: [prospectId], references: [id], onDelete: Cascade)

  email     String
  firstName String?
  lastName  String?
  role      String?
  phone     String?

  /// true si contact@, info@... (pas une donnee personnelle : regime RGPD plus souple)
  isGeneric Boolean @default(true)

  /// LEGAL_NOTICE | WEBSITE_CONTACT | WEBSITE_MAILTO | GOOGLE_BUSINESS | INSTAGRAM_BIO | MANUAL
  discoveryMethod String
  sourceUrl       String
  sourceSnippet   String?
  discoveredAt    DateTime @default(now())

  /// SYNTAX_OK | SYNTAX_INVALID | DISPOSABLE | ROLE_ACCOUNT | UNKNOWN
  validationStatus String  @default("UNKNOWN")
  validationNote   String?

  isPrimary Boolean @default(false)

  primaryFor Prospect? @relation("PrimaryContact")

  @@unique([prospectId, email])
  @@index([email])
}

// ---------------------------------------------------------------------------
// CAMPAGNES & EMAILS
// ---------------------------------------------------------------------------

model Campaign {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// Criteres de ciblage (JSON) : villes, secteurs, nombre vise...
  targetCriteria String?
  targetOffer    String?
  language       String  @default("fr")

  fromEmail String
  fromName  String

  status String @default("DRAFT") // DRAFT | READY | RUNNING | PAUSED | DONE | CANCELLED

  dailyLimit        Int @default(15)
  minDelaySeconds   Int @default(180)
  maxFollowUps      Int @default(2)
  followUpDelayDays Int @default(4)

  isDemo    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  startedAt DateTime?
  endedAt   DateTime?

  members CampaignMember[]
  drafts  EmailDraft[]
  sends   SendLog[]
  replies Reply[]

  @@index([status])
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  /// PENDING | READY | APPROVED | SENT | REPLIED | BLOCKED | SKIPPED | DONE
  status        String  @default("PENDING")
  blockedReason String?

  sequenceStep Int       @default(0) // 0 = email initial, 1..n = relances
  lastSentAt   DateTime?
  nextSendAt   DateTime?

  addedAt DateTime @default(now())

  @@unique([campaignId, prospectId])
  @@index([status])
}

model EmailDraft {
  id         String    @id @default(cuid())
  prospectId String
  prospect   Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// INITIAL | FOLLOWUP_1 | FOLLOWUP_2 | REPLY
  kind         String @default("INITIAL")
  sequenceStep Int    @default(0)

  subject String
  body    String

  /// JSON : ids des Issue reellement citees. Verifie avant envoi.
  citedIssueIds String  @default("[]")
  generator     String  @default("template") // template | claude
  model         String?

  verificationPassed Boolean @default(false)
  verificationNotes  String?

  approvedAt DateTime?
  approvedBy String?

  isActive    Boolean  @default(true)
  generatedAt DateTime @default(now())

  sendLogs SendLog[]

  @@index([prospectId])
  @@index([campaignId])
}

model SendLog {
  id           String      @id @default(cuid())
  prospectId   String
  prospect     Prospect    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  emailDraftId String?
  emailDraft   EmailDraft? @relation(fields: [emailDraftId], references: [id], onDelete: SetNull)
  campaignId   String?
  campaign     Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  transport String
  /// SIMULATED | SENT | FAILED | BLOCKED | BOUNCED
  status    String
  dryRun    Boolean @default(true)

  toEmail String
  subject String @default("")

  providerMessageId String?
  error             String?
  bounceType        String? // HARD | SOFT
  bounceDetail      String?

  /// JSON : resultat de chaque controle de conformite avant envoi
  complianceReport String?

  sequenceStep Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([prospectId])
  @@index([campaignId])
  @@index([createdAt])
  @@index([status])
}

model Reply {
  id String @id @default(cuid())

  /// Optionnel : une reponse peut venir d'un expediteur inconnu. On l'enregistre
  /// quand meme plutot que de la perdre, avec matchedBy = "NONE".
  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  fromEmail  String
  fromName   String?
  toEmail    String?
  subject    String
  body       String
  receivedAt DateTime @default(now())

  /// INTERESTED | PRICE_REQUEST | MEETING_REQUEST | QUESTION | POSITIVE |
  /// LATER | NOT_INTERESTED | NEGATIVE | OPT_OUT | BOUNCE | NEEDS_HUMAN | UNKNOWN
  classification    String
  confidence        String  @default("MEDIUM")
  /// JSON : expressions qui ont declenche le classement (tracabilite)
  matchedSignals    String?
  /// Prochaine action suggeree. JAMAIS executee automatiquement.
  recommendedAction String?

  /// Comment le prospect a ete retrouve : CONTACT | SEND_LOG | CLIENT | DOMAIN | NONE
  matchedBy String @default("NONE")

  /// Provenance : MANUAL (saisie CLI) | IMAP (boite contact@amyn.agency)
  source     String  @default("MANUAL")
  /// En-tete Message-ID du courriel. Cle de deduplication durable.
  messageId  String? @unique
  /// Dossier IMAP et UID d'origine, pour retrouver le message dans la boite.
  imapFolder String?
  imapUid    Int?

  /// Decision de l'operateur : REPLY | SCHEDULE_FOLLOWUP | STOP_SEQUENCE |
  /// BLACKLIST | HUMAN_REVIEW | NONE
  decisionAction String?
  /// La decision peut-elle s'executer sans validation humaine ?
  decisionAuto   Boolean @default(false)
  decisionReason String?

  /// Reponse REDIGEE par l'agent, jamais envoyee sans approbation.
  proposedSubject String?
  proposedBody    String?
  /// DRAFT | APPROVED | SENT | REJECTED
  proposedStatus  String?
  proposedAt      DateTime?
  approvedBy      String?

  /// NEW | REVIEWED | ACTION_REQUIRED | RESOLVED
  reviewStatus String    @default("NEW")
  handled      Boolean   @default(false)
  handledAt    DateTime?
  handledNote  String?

  externalId String? @unique

  @@index([prospectId])
  @@index([classification])
  @@index([reviewStatus])
  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// TERRITOIRES — le balayage national, decoupe en unites reprenables
// ---------------------------------------------------------------------------

/// Une unite de travail du balayage national : « les restaurants du Nord ».
///
/// POURQUOI DECOUPER. Les API du registre des entreprises refusent de servir
/// au-dela de 10 000 resultats pour une meme requete. « Toutes les entreprises
/// de France » est donc materiellement impossible a demander d'un bloc — il
/// faut poser des milliers de questions etroites. Le territoire est cette
/// question etroite, rendue persistante.
///
/// REPRISE. Le curseur et le numero de page sont ecrits en base APRES chaque
/// page importee. Une coupure — plantage, arret du worker, redemarrage de la
/// machine — fait perdre au pire la page en cours ; la suivante repart
/// exactement ou la precedente s'est arretee, jamais du debut.
model Territory {
  id String @id @default(cuid())

  /// NATIONAL | REGION | DEPARTEMENT | COMMUNE
  scope String
  /// Code de la zone : « 59 », « 32 » (region), « 59350 » (commune), « FR ».
  code  String
  label String

  /// Identite du secteur : cle du catalogue cure, code de division NAF, ou
  /// "ALL". Sert a l'unicite du territoire, PAS a construire la requete.
  sectorKey   String @default("ALL")
  sectorLabel String @default("Tous secteurs")

  /// Codes NAF reellement interroges, en JSON.
  ///
  /// Distinct de `sectorKey`, et ce n'est pas une redondance : « restaurant »
  /// est une cle lisible, pas un code que l'API comprend. Les confondre
  /// revenait a filtrer sur `activite_principale=restaurant` — une requete
  /// syntaxiquement valide qui ne renvoie jamais rien. Un tableau vide
  /// signifie « tous secteurs ».
  naf String @default("[]")

  /// Source interrogee : SIRENE | ANNUAIRE
  source String

  /// PENDING | RUNNING | DONE | SATURATED | FAILED | PAUSED
  ///
  /// SATURATED signale un territoire dont le volume depasse ce que la source
  /// accepte de servir. Ce n'est pas une erreur : c'est une invitation a le
  /// subdiviser. Le compter comme « termine » masquerait des entreprises
  /// jamais vues.
  status String @default("PENDING")

  // --- Checkpoint ------------------------------------------------------
  /// Curseur d'API (Sirene) — opaque, rejoue tel quel.
  cursor       String?
  /// Numero de page suivante a demander (sources paginees par rang).
  nextPage     Int       @default(1)
  /// Total annonce par la source, quand elle le fournit.
  totalResults Int?
  checkpointAt DateTime?

  // --- Compteurs cumules -----------------------------------------------
  discovered Int @default(0)
  created    Int @default(0)
  duplicates Int @default(0)
  qualified  Int @default(0)
  rejected   Int @default(0)
  needsHuman Int @default(0)
  errors     Int @default(0)

  lastError   String?
  lastRunAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  prospects Prospect[]

  /// Un territoire est defini par sa source, sa zone et son secteur. Le
  /// replanifier ne le duplique pas : il est retrouve et poursuivi.
  @@unique([source, scope, code, sectorKey])
  @@index([status])
  @@index([source, status])
  @@index([scope])
}

/// Execution d'un job planifie.
///
/// IDEMPOTENCE : `lockKey` est unique. Un job qui tourne deux fois pour la
/// meme fenetre ne peut pas creer deux executions — la seconde echoue a
/// l'insertion et s'arrete proprement.
model JobRun {
  id  String @id @default(cuid())
  job String

  /// Cle d'unicite : "<job>:<fenetre>". Empeche tout doublon.
  lockKey String @unique

  /// RUNNING | DONE | FAILED | SKIPPED
  status  String  @default("RUNNING")
  summary String?
  error   String?

  /// JSON : compteurs de l'execution
  result String?

  itemsSeen    Int @default(0)
  itemsChanged Int @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  @@index([job])
  @@index([startedAt])
  @@index([status])
}

/// Etat de synchronisation IMAP, par dossier. Permet de ne relire que les
/// messages nouveaux au lieu de reparcourir toute la boite.
model ImapSyncState {
  id     String @id @default(cuid())
  folder String @unique

  /// Dernier UID traite dans ce dossier.
  lastSeenUid Int     @default(0)
  /// UIDVALIDITY du dossier : s'il change, les UID precedents ne valent plus
  /// rien et la synchronisation repart de zero.
  uidValidity String?

  lastRunAt      DateTime?
  lastError      String?
  messagesSeen   Int       @default(0)
  messagesStored Int       @default(0)

  updatedAt DateTime @updatedAt
}

/// Liste d'opposition. Une adresse ou un domaine ici n'est JAMAIS recontacte.
model Suppression {
  id     String  @id @default(cuid())
  email  String? @unique
  domain String? @unique

  /// UNSUBSCRIBED | BOUNCED | COMPLAINT | MANUAL | DEMO_GUARD
  reason     String
  source     String?
  campaignId String?
  notes      String?
  createdAt  DateTime @default(now())

  @@index([reason])
}

// ---------------------------------------------------------------------------
// CRM — CLIENTS, PROJETS, LIVRAISON
// ---------------------------------------------------------------------------

model Client {
  id         String    @id @default(cuid())
  prospectId String?   @unique
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  companyName  String
  contactName  String?
  contactEmail String
  contactPhone String?
  city         String?
  sector       String?

  offer      String // ESSENTIAL | PREMIUM | ULTIMATE
  offerPrice Int

  /// ACTIVE | ONBOARDING | IN_PRODUCTION | DELIVERED | CHURNED
  status String @default("ONBOARDING")

  isDemo    Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  documents Document[]
  payments  Payment[]
  care      CareSubscription?

  @@index([status])
}

model Project {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name  String
  offer String

  /// ONBOARDING | CONTENT | PRODUCTION | QA | DELIVERY | DONE | BLOCKED
  phase  String @default("ONBOARDING")
  status String @default("ACTIVE") // ACTIVE | BLOCKED | DONE | CANCELLED

  blockedReason String?
  dueAt         DateTime?
  deliveredAt   DateTime?
  deliveredUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      Task[]
  onboarding OnboardingItem[]
  documents  Document[]

  @@index([clientId])
  @@index([phase])
}

model Task {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?
  /// SETUP | CONTENT | DESIGN | DEV | SEO | BOOKING | AUTOMATION | QA | DELIVERY | CARE
  category    String
  phase       String

  /// TODO | BLOCKED | IN_PROGRESS | DONE | SKIPPED
  status          String  @default("TODO")
  blockedReason   String?
  /// La tache attend-elle une information client ?
  waitingOnClient Boolean @default(false)

  requiresApproval Boolean @default(false)
  position         Int     @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([projectId])
  @@index([status])
}

/// Une information demandee au client pendant l'onboarding.
model OnboardingItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  key       String
  label     String
  hint      String?
  /// TEXT | LONGTEXT | FILE | URL | LIST | COLOR
  inputType String  @default("TEXT")
  category  String

  required Boolean @default(true)
  /// MISSING | RECEIVED | NOT_APPLICABLE
  status   String  @default("MISSING")
  value    String?

  receivedAt DateTime?
  position   Int       @default(0)

  @@unique([projectId, key])
  @@index([projectId])
}

model Document {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// DEVIS | FACTURE | CONTRAT | BRIEF | CHECKLIST | LIVRAISON
  type   String
  title  String
  /// DRAFT | READY | SENT | SIGNED | VOID
  status String @default("DRAFT")

  content  String? // Markdown genere
  filePath String?

  /// Un contrat ne peut jamais passer a SIGNED sans validation humaine.
  requiresApproval Boolean   @default(true)
  approvedAt       DateTime?
  approvedBy       String?

  createdAt DateTime @default(now())

  @@index([clientId])
}

model Payment {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  label    String
  amount   Int // en euros
  currency String @default("EUR")

  /// PAYMENT_PENDING | PAYMENT_RECEIVED | PAYMENT_FAILED | REFUNDED
  status String  @default("PAYMENT_PENDING")
  /// Aucun encaissement automatique : renseigne manuellement ou par un
  /// prestataire de paiement configure ulterieurement.
  method String?

  dueAt  DateTime?
  paidAt DateTime?
  note   String?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([status])
}

model CareSubscription {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  monthlyPrice Int    @default(99)
  /// ACTIVE | PAUSED | CANCELLED
  status       String @default("ACTIVE")

  startedAt DateTime  @default(now())
  renewsAt  DateTime?
  endedAt   DateTime?

  events CareEvent[]
}

model CareEvent {
  id     String           @id @default(cuid())
  careId String
  care   CareSubscription @relation(fields: [careId], references: [id], onDelete: Cascade)

  /// MAINTENANCE | BACKUP | INCIDENT | REQUEST | MONITORING | UPDATE
  type        String
  title       String
  description String?
  /// OPEN | IN_PROGRESS | DONE
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([careId])
}

// ---------------------------------------------------------------------------
// AGENT & ORCHESTRATION
// ---------------------------------------------------------------------------

/// Une instruction donnee a l'agent et son execution.
/// Mission commerciale confiee a l'operateur.
///
/// Relie une instruction ("Prospecte les coiffeurs de Lille") a tout ce qu'elle
/// a produit : prospects trouves, qualifies, emails prepares, blocages.
model Mission {
  id    String @id @default(cuid())
  brief String

  /// JSON : criteres extraits (secteur, ville, nombre vise...)
  criteria String?

  /// PLANNED | RUNNING | WAITING_APPROVAL | DONE | FAILED | PARTIAL
  status  String  @default("PLANNED")
  summary String?

  /// JSON : ce que l'operateur attend de vous
  needsHuman String?

  prospectsFound      Int @default(0)
  prospectsQualified  Int @default(0)
  prospectsRejected   Int @default(0)
  prospectsNeedsHuman Int @default(0)
  emailsPrepared      Int @default(0)

  campaignId String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  steps MissionStep[]

  @@index([status])
  @@index([startedAt])
}

/// Une etape de mission. Chaque etape dit ce qu'elle a fait ET pourquoi.
model MissionStep {
  id        String  @id @default(cuid())
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  /// RESEARCH | QUALIFY | AUDIT | CONTACT | SCORE | DRAFT | CAMPAIGN | SEND
  stage       String
  description String
  rationale   String?

  /// DONE | SKIPPED | FAILED | WAITING_APPROVAL
  status String  @default("DONE")
  /// JSON : entrees et sorties
  result String?
  error  String?

  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([missionId])
}

model AgentRun {
  id          String  @id @default(cuid())
  instruction String
  /// Intention reconnue (SEARCH | AUDIT | CONTACT | SCORE | DRAFT | CAMPAIGN |
  /// SEND | REPLY | NEW_CLIENT | ONBOARDING | PROJECT | STATUS | UNKNOWN)
  intent      String
  /// JSON : parametres extraits de l'instruction
  parameters  String?
  /// Comment l'intention a ete determinee : PATTERN | CLAUDE | EXPLICIT
  parsedBy    String  @default("PATTERN")

  /// PLANNED | RUNNING | WAITING_APPROVAL | DONE | FAILED | PARTIAL
  status  String  @default("PLANNED")
  summary String?
  error   String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  actions AgentAction[]

  @@index([status])
  @@index([startedAt])
}

/// Une action elementaire decidee par l'agent. Tracabilite complete :
/// ce qui a ete fait, pourquoi, avec quelle source, quel resultat.
model AgentAction {
  id         String   @id @default(cuid())
  agentRunId String
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  module      String // RESEARCH | AUDIT | CONTACT | SCORING | EMAIL | CAMPAIGN | SEND | REPLIES | CRM | PROJECT
  type        String
  description String
  /// Pourquoi cette action a ete decidee
  rationale   String?

  /// AUTOMATIC | APPROVAL_REQUIRED
  autonomy String @default("AUTOMATIC")
  /// PENDING | WAITING_APPROVAL | RUNNING | DONE | FAILED | SKIPPED | REJECTED
  status   String @default("PENDING")

  approvedAt DateTime?
  approvedBy String?
  rejectedAt DateTime?

  /// JSON : entrees, sorties, sources utilisees
  input  String?
  result String?
  error  String?

  position   Int       @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([agentRunId])
  @@index([status])
}

/// Journal d'audit global. Toute action importante laisse une trace.
model ActivityLog {
  id String @id @default(cuid())

  actor      String // SYSTEM | AGENT | HUMAN
  action     String
  module     String
  entityType String?
  entityId   String?

  summary String
  /// JSON : details, valeurs avant/apres
  details String?
  level   String  @default("INFO") // INFO | WARN | ERROR

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([module])
  @@index([level])
}

model StatusEvent {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  fromStatus String?
  toStatus   String
  reason     String?
  actor      String   @default("SYSTEM")
  createdAt  DateTime @default(now())

  @@index([prospectId])
}

/// Reglages modifiables sans redeploiement (niveaux d'autonomie, limites...).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
