{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "testflight-diagnostics": {
      "extends": "production",
      "environment": "production"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://devisia-bice.vercel.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "mrfitman99@gmail.com",
        "ascAppId": "6806865251",
        "appleTeamId": "9Q6YL8R33R"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
