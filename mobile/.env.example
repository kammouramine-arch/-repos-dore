# =============================================================================
# DEVISIA mobile (Expo) — variables publiques
# Ces valeurs sont embarquées dans le binaire : n'y placez jamais de secret.
# =============================================================================

# URL de l'API DEVISIA utilisée par l'application.
# Développement : http://localhost:3000 (ou l'IP locale de votre machine pour
# tester sur un téléphone physique, ex. http://192.168.1.20:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Identifiant du projet EAS, créé par `eas init`.
EAS_PROJECT_ID=
