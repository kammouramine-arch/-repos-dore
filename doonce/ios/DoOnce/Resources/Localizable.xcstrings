    "app.tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show it once."
          }
        }
      }
    },
    "onboarding.1.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some things you only learn once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines choses ne s'apprennent qu'une fois."
          }
        }
      }
    },
    "onboarding.1.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DoOnce remembers how they're done."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DoOnce se souvient comment on les fait."
          }
        }
      }
    },
    "onboarding.2.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show it once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montrez-le une fois."
          }
        }
      }
    },
    "onboarding.2.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DoOnce watches, listens and turns the demonstration into a memory."
          }
        }
      }
    },
    "onboarding.3.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find it by looking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez-le en regardant."
          }
        }
      }
    },
    "onboarding.3.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point your phone at something you've remembered."
