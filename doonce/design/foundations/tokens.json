{
  "$schema": "doonce-tokens/1",
  "name": "DoOnce Design Tokens",
  "note": "Single source of truth. build-tokens.mjs generates prototype/assets/tokens.css and ios/DoOnce/DesignSystem/Generated/Tokens.swift. Semantic names only; never reference a raw hex from a screen.",
  "color": {
    "light": {
      "backgroundPrimary": "#F7F7F4",
      "backgroundElevated": "#FFFFFF",
      "backgroundSunken": "#EEEEE9",
      "backgroundInverse": "#111210",
      "textPrimary": "#111210",
      "textSecondary": "#66685F",
      "textTertiary": "#9A9C93",
      "textOnSignal": "#111210",
      "textOnInverse": "#F2F2EE",
      "textOnMedia": "#F2F2EE",
      "signal": "#8BD400",
      "signalStrong": "#6DB400",
      "signalText": "#3F7D00",
      "signalSoft": "#EAF7CF",
      "success": "#6DB400",
      "warning": "#D99A00",
      "warningSoft": "#FBF1D6",
      "warningText": "#8A6100",
      "danger": "#C8392E",
      "dangerSoft": "#FBE3E0",
      "recording": "#E5443A",
      "separator": "rgba(17,18,16,0.08)",
      "separatorStrong": "rgba(17,18,16,0.16)",
      "fillSubtle": "rgba(17,18,16,0.05)",
      "fillMedium": "rgba(17,18,16,0.10)",
      "fillStrong": "rgba(17,18,16,0.16)",
      "glassNavigation": "rgba(247,247,244,0.74)",
      "glassControl": "rgba(255,255,255,0.62)",
      "glassOnMedia": "rgba(20,21,19,0.40)",
      "scrimMedia": "rgba(9,10,9,0.55)",
      "shadow": "rgba(17,18,16,0.14)"
    },
    "dark": {
      "backgroundPrimary": "#090A09",
      "backgroundElevated": "#161715",
      "backgroundSunken": "#040504",
      "backgroundInverse": "#F2F2EE",
      "textPrimary": "#F2F2EE",
      "textSecondary": "#9C9E96",
      "textTertiary": "#6A6C65",
      "textOnSignal": "#111210",
      "textOnInverse": "#111210",
      "textOnMedia": "#F2F2EE",
      "signal": "#CFF25A",
      "signalStrong": "#DDFF7A",
      "signalText": "#CFF25A",
      "signalSoft": "#1E2A0B",
      "success": "#CFF25A",
      "warning": "#F2B63C",
      "warningSoft": "#2C230C",
      "warningText": "#F2B63C",
      "danger": "#F0645A",
      "dangerSoft": "#2E1412",
      "recording": "#FF5A4E",
      "separator": "rgba(242,242,238,0.10)",
      "separatorStrong": "rgba(242,242,238,0.18)",
      "fillSubtle": "rgba(242,242,238,0.06)",
      "fillMedium": "rgba(242,242,238,0.11)",
      "fillStrong": "rgba(242,242,238,0.18)",
      "glassNavigation": "rgba(18,19,17,0.68)",
      "glassControl": "rgba(38,39,36,0.58)",
      "glassOnMedia": "rgba(9,10,9,0.44)",
      "scrimMedia": "rgba(9,10,9,0.62)",
      "shadow": "rgba(0,0,0,0.55)"
    }
  },
  "typography": {
    "family": {
      "ios": "SF Pro (system)",
      "web": "Inter, -apple-system, system-ui"
    },
    "tracking": {
      "display": "-0.028em",
      "title": "-0.02em",
      "body": "0",
      "caption": "0.004em"
    },
    "styles": {
      "display": {
        "size": 40,
        "line": 44,
        "weight": 800,
        "tracking": "display",
        "note": "Do-mode instruction, onboarding headline"
      },
      "largeTitle": {
        "size": 34,
        "line": 40,
        "weight": 700,
        "tracking": "title",
        "note": "Editorial screen title"
      },
      "title1": {
        "size": 28,
        "line": 34,
        "weight": 700,
        "tracking": "title"
      },
      "title2": {
        "size": 22,
        "line": 28,
        "weight": 600,
        "tracking": "title"
      },
      "title3": {
        "size": 20,
        "line": 25,
        "weight": 600,
        "tracking": "title"
      },
      "headline": {
        "size": 17,
        "line": 22,
        "weight": 600,
        "tracking": "body"
      },
      "body": {
        "size": 17,
        "line": 22,
        "weight": 400,
        "tracking": "body"
      },
      "callout": {
        "size": 16,
        "line": 21,
        "weight": 400,
        "tracking": "body"
      },
      "subheadline": {
        "size": 15,
        "line": 20,
        "weight": 400,
        "tracking": "body"
      },
      "footnote": {
        "size": 13,
        "line": 18,
        "weight": 400,
        "tracking": "caption"
      },
      "caption": {
        "size": 12,
        "line": 16,
        "weight": 500,
        "tracking": "caption"
      },
      "label": {
        "size": 11,
        "line": 13,
        "weight": 600,
        "tracking": "0.06em",
        "note": "Uppercase eyebrow. Use rarely."
      },
      "numeral": {
        "size": 56,
        "line": 60,
        "weight": 700,
        "tracking": "display",
        "note": "Monospaced digits. Timers, gauges, 2 of 5."
      }
    }
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "gutter": 20
  },
  "radius": {
    "small": 10,
    "medium": 16,
    "large": 24,
    "xlarge": 32,
    "sheet": 38,
    "capsule": 999
  },
  "elevation": {
    "none": {
      "shadow": "none"
    },
    "raised": {
      "shadow": "0 1px 2px var(--shadow), 0 6px 20px -8px var(--shadow)"
    },
    "floating": {
      "shadow": "0 2px 6px var(--shadow), 0 16px 40px -12px var(--shadow)"
    },
    "hero": {
      "shadow": "0 24px 60px -20px var(--shadow)"
    }
  },
  "blur": {
    "navigation": 24,
    "control": 18,
    "onMedia": 28,
    "bloom": 14
  },
  "motion": {
    "duration": {
      "instant": 120,
      "quick": 180,
      "standard": 260,
      "navigation": 380,
      "hero": 620,
      "recognition": 640,
      "launchShort": 520,
      "launchFull": 1100
    },
    "curve": {
      "standard": {
        "css": "cubic-bezier(0.2, 0, 0, 1)",
        "note": "Enter / settle"
      },
      "exit": {
        "css": "cubic-bezier(0.4, 0, 1, 1)"
      },
      "emphasized": {
        "css": "cubic-bezier(0.32, 0.72, 0, 1)",
        "note": "Hero & sheet"
      }
    },
    "spring": {
      "snappy": {
        "response": 0.32,
        "damping": 0.86,
        "css": "cubic-bezier(0.22, 1, 0.36, 1)",
        "note": "Press, toggles, chips"
      },
      "gentle": {
        "response": 0.5,
        "damping": 0.88,
        "css": "cubic-bezier(0.32, 0.72, 0, 1)",
        "note": "Navigation, sheets"
      },
      "lively": {
        "response": 0.42,
        "damping": 0.72,
        "css": "cubic-bezier(0.34, 1.35, 0.5, 1)",
        "note": "Bloom, recognition pulse. Never for text."
      }
    },
    "press": {
      "scale": 0.985,
      "cardScale": 0.97,
      "opacity": 0.92
    },
    "reduceMotion": {
      "crossfadeDuration": 200,
      "note": "Replace spatial morphs with crossfades; remove overshoot; disable parallax."
    }
  },
  "haptic": {
    "selection": {
      "ios": "UISelectionFeedbackGenerator",
      "use": [
        "picker move",
        "snap",
        "switch object target",
        "timeline scrub"
      ]
    },
    "light": {
      "ios": "UIImpactFeedbackGenerator(.light)",
      "use": [
        "button commit",
        "card locks",
        "center menu open"
      ]
    },
    "medium": {
      "ios": "UIImpactFeedbackGenerator(.medium)",
      "use": [
        "recording starts",
        "object recognized",
        "procedure starts"
      ]
    },
    "rigid": {
      "ios": "UIImpactFeedbackGenerator(.rigid)",
      "use": [
        "logo loop closes"
      ]
    },
    "success": {
      "ios": "UINotificationFeedbackGenerator(.success)",
      "use": [
        "memory created",
        "procedure completed",
        "object linked"
      ]
    },
    "warning": {
      "ios": "UINotificationFeedbackGenerator(.warning)",
      "use": [
        "dangerous step",
        "incomplete recognition",
        "missing info"
      ]
    },
    "error": {
      "ios": "UINotificationFeedbackGenerator(.error)",
      "use": [
        "real failure only"
      ]
    }
  },
  "sizing": {
    "touchMin": 44,
    "touchComfort": 52,
    "centerAction": 64,
    "navHeight": 76,
    "recordButton": 82,
    "avatar": 40
  }
}
